# =====================================================================
#  Wzór zmiennych środowiskowych.
#  Lokalnie: skopiuj jako .env i uzupełnij.
#  Serwer:   wpisz te same nazwy w Coolify -> Environment Variables.
#  Plik .env NIGDY nie trafia do repozytorium.
#
#  Losowe hasło/klucz wygenerujesz np. w PowerShellu:
#    [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
#  albo na serwerze:  openssl rand -base64 48
# =====================================================================

POSTGRES_DB=herb-recognition-db
POSTGRES_USER=herb
POSTGRES_PASSWORD=zmien-na-dlugie-losowe-haslo

ADMIN_USERNAME=zmien-login
ADMIN_PASSWORD=zmien-na-silne-haslo
JWT_KEY=zmien-na-losowy-ciag-minimum-32-znaki

# adres strony: lokalnie http://localhost:8080, na serwerze https://twojadomena.pl
PUBLIC_URL=http://localhost:8080

# lokalnie *, na serwerze: twojadomena.pl;www.twojadomena.pl
ALLOWED_HOSTS=*
