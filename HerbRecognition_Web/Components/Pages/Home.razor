@page "/"
@implements IDisposable

@using HerbRecognition_Web.Communication.Services
@using HerbRecognition_Web.Components.Shared

@inject PlantApiService PlantApi
@inject PersistentComponentState AppState

<PageTitle>Herb Recognition</PageTitle>

<section class="hero">

    <div class="hero-content">

        <div class="hero-text">

            <span class="hero-label">
                🌱 HERB RECOGNITION
            </span>

            <h1>
                Poznaj świat
                <span>roślin.</span>
            </h1>

            <p class="hero-description">
                Herb Recognition to aplikacja pozwalająca poznawać
                i rozpoznawać rośliny na podstawie ich charakterystycznych
                cech.
            </p>

            <p class="hero-description secondary">
                Odkrywaj gatunki, poznawaj ich właściwości i poszerzaj
                swoją wiedzę o świecie roślin. Odkryj również ich właściwości zdrowotne i przepisy.
            </p>

            @* ----- wyszukiwarka: rośliny albo przepisy ----- *@
            <div class="hero-search">
                <div class="hero-search-tabs" role="group" aria-label="Czego szukasz?">
                    <button type="button" class="hero-search-tab"
                            aria-pressed="@(searchProducts ? "false" : "true")"
                            @onclick="() => searchProducts = false">
                        <span aria-hidden="true">🌿</span> Rośliny
                    </button>
                    <button type="button" class="hero-search-tab"
                            aria-pressed="@(searchProducts ? "true" : "false")"
                            @onclick="() => searchProducts = true">
                        <span aria-hidden="true">🍯</span> Przepisy
                    </button>
                </div>

                @if (searchProducts)
                {
                    <ProductSearchBar />
                }
                else
                {
                    <SearchBar />
                }
            </div>

            <div class="hero-actions">

                <a href="/plants" class="primary-button">
                    Wszystkie rośliny
                    <span>→</span>
                </a>

                <a href="/products" class="primary-button">
                    Wszystkie przepisy
                    <span>→</span>
                </a>

                <a href="#about" class="secondary-button">
                    O projekcie
                </a>

            </div>

        </div>


        @if (hero is not null)
        {
            @* losowa zatwierdzona roślina ze zdjęciem *@
            <figure class="hero-figure">
                <a href="@($"/plants/{hero.PlantId}")" class="hero-image-wrapper" tabindex="-1" aria-hidden="true">
                    <img src="@hero.ImageUrl" alt="" class="hero-image" />
                    <div class="image-decoration"></div>
                </a>

                <figcaption class="hero-caption">
                    <a href="@($"/plants/{hero.PlantId}")">
                        <span class="hero-caption-name">
                            <span aria-hidden="true">@hero.TypeIcon</span>
                            @hero.PolishName
                        </span>

                        @if (!string.IsNullOrWhiteSpace(hero.LatinName))
                        {
                            <span class="hero-caption-latin">@hero.LatinName</span>
                        }

                        <span class="hero-caption-more">
                            Dowiedz się więcej... <span aria-hidden="true">→</span>
                        </span>
                    </a>
                </figcaption>
            </figure>
        }
        else
        {
            @* brak roślin ze zdjęciem albo błąd API – dotychczasowe zdjęcie *@
            <div class="hero-image-wrapper">
                <img src="https://images.unsplash.com/photo-1501004318641-b39e6451bec6"
                     alt="Zielone rośliny"
                     class="hero-image" />
                <div class="image-decoration"></div>
            </div>
        }

    </div>

</section>


<section id="about" class="about-section">

    <div class="about-content">

        <span class="section-label">O PROJEKCIE</span>

        <h2>
            Rozpoznawanie roślin
            <br />
            w prostszy sposób.
        </h2>

        <p>
            Projekt łączy aplikację webową z bazą danych zawierającą
            informacje o roślinach, ich charakterystycznych cechach oraz właściwościach.
            W przyszłości użytkownik będzie mógł wykorzystać te dane
            do identyfikacji interesujących go gatunków.
            ONLINE!
        </p>

    </div>

</section>


@code {
    private const string StateKey = "home-hero";

    private HeroPick? hero;
    private PersistingComponentStateSubscription persisting;

    /// <summary>Wyszukiwarka na stronie głównej: false = rośliny, true = przepisy.</summary>
    private bool searchProducts;

    public sealed record HeroPick(int PlantId, string PolishName, string? LatinName, string TypeIcon, string ImageUrl);

    protected override async Task OnInitializedAsync()
    {
        // pojedyncze losowanie zdjecia na strone home
        persisting = AppState.RegisterOnPersisting(PersistHero);

        hero = AppState.TryTakeFromJson<HeroPick>(StateKey, out var restored)
            ? restored
            : await PickRandomAsync();
    }

    private Task PersistHero()
    {
        AppState.PersistAsJson(StateKey, hero);
        return Task.CompletedTask;
    }

    private async Task<HeroPick?> PickRandomAsync()
    {
        try
        {
            var withPhoto = (await PlantApi.GetAllPlantsAsync())
                .Where(p => SafeUrl.Image(p.MainThumbnailUrl) is not null)
                .ToList();

            if (withPhoto.Count == 0) return null;

            var plant = withPhoto[Random.Shared.Next(withPhoto.Count)];

            // pełne zdjęcie główne (1536 px); miniatura 400 px byłaby rozmyta w dużym kadrze
            string? image = null;
            try
            {
                var pictures = await PlantApi.GetPlantPicturesAsync(plant.Id);
                image = pictures.Select(p => SafeUrl.Image(p.Url)).FirstOrDefault(url => url is not null);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Nie udało się pobrać zdjęć rośliny {plant.Id}: {ex.Message}");
            }

            image ??= SafeUrl.Image(plant.MainThumbnailUrl)!;

            return new HeroPick(
                plant.Id,
                plant.PolishName,
                plant.LatinName,
                PlantTypeIcon.For(plant.PlantTypeDTO?.Name),
                image);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Nie udało się wylosować rośliny na stronę główną: {ex.Message}");
            return null;
        }
    }

    public void Dispose() => persisting.Dispose();
}
