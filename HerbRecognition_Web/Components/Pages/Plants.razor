@page "/plants"

@using HerbRecognition_Web.Communication.DTOs
@using HerbRecognition_Web.Communication.Services

@inject PlantApiService PlantApiService

<PageTitle>Wszystkie rośliny</PageTitle>

<div class="plants-page">

    <section class="plants-header">

        <div>
            <span class="section-label">HERB RECOGNITION</span>

            <h1>Wszystkie rośliny</h1>

            <p>
                Odkrywaj rośliny znajdujące się w bazie Herb Recognition.
            </p>

            <HerbRecognition_Web.Components.Shared.SearchBar />
        </div>

    </section>


    @if (isLoading)
    {
        <div class="plants-status">
            <div class="loading-spinner"></div>
            <p>Ładowanie roślin...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="plants-error">
            <h2>Nie udało się pobrać roślin</h2>

            <p>@errorMessage</p>

            <button @onclick="LoadPlantsAsync">
                Spróbuj ponownie
            </button>
        </div>
    }
    else if (plants.Count == 0)
    {
        <div class="plants-status">
            <h2>Brak roślin</h2>
            <p>Baza nie zawiera jeszcze żadnych roślin.</p>
        </div>
    }
    else
    {
        <section class="plants-grid">

            @foreach (var plant in plants)
            {
                <article class="plant-card">

                    <div class="plant-card-content">

                        <div class="plant-card-top">

                            <div class="plant-pills">
                                <div class="plant-type-badge">
                                    @(plant.PlantTypeDTO?.Name ?? "Unknown")
                                </div>

                                @if (!string.IsNullOrEmpty(plant.MonthOfHarvestName))
                                {
                                    <div class="plant-type-badge plant-month">
                                        Zbiór: @plant.MonthOfHarvestName
                                    </div>
                                }
                            </div>
                            @* <div class="plant-pills">
                                <span class="plant-type">
                                    @(plant.PlantTypeDTO?.Name ?? "Unknown")
                                </span>

                                @if (!string.IsNullOrEmpty(plant.MonthOfHarvestName))
                                {
                                    <span class="plant-type plant-month">
                                        Zbiór: @plant.MonthOfHarvestName
                                    </span>
                                }
                            </div> *@

                            <span class="plant-id">
                                #@plant.Id
                            </span>

                            @* <span class="plant-type">
                                @(plant.PlantTypeDTO?.Name ?? "Unknown")
                            </span>

                            <span class="plant-id">
                                #@plant.Id
                            </span> *@

                        </div>


                        <h2>@plant.PolishName</h2>

                        <p class="plant-name">
                            @plant.Name
                        </p>

                        <p class="plant-latin">
                            @plant.LatinName
                        </p>


                        @if (!string.IsNullOrWhiteSpace(plant.Subriquet))
                        {
                            <p class="plant-subriquet">
                                „@plant.Subriquet”
                            </p>
                        }


                        <a href="@($"/plants/{plant.Id}")"
                           class="plant-card-link">

                            Zobacz szczegóły
                            <span>→</span>

                        </a>

                    </div>

                </article>
            }
            <div class="plant-card-content">
                <p> Nie ma rośliny, której szukasz? Możesz zgłosić ją za pomocą formularza. </p>
                <a href="/plant-form" class="plant-form-button"> Przejdź do formularza <span>→</span> </a>
            </div>

        </section>
    }

</div>


@code {

    private List<GetPreviewPlantDTO> plants = new();

    private bool isLoading = true;

    private string? errorMessage;


    protected override async Task OnInitializedAsync()
    {
        await LoadPlantsAsync();
    }


    private async Task LoadPlantsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            plants = await PlantApiService.GetAllPlantsAsync();
        }
        catch (Exception ex)
        {
            errorMessage = "Wystąpił problem podczas komunikacji z API.";
        }
        finally
        {
            isLoading = false;
        }
    }
}