@page "/plants"

@using System.Globalization
@using HerbRecognition_Web.Communication.DTOs
@using HerbRecognition_Web.Communication.Services

@inject PlantApiService PlantApiService

<PageTitle>Wszystkie rośliny</PageTitle>

<div class="plants-page">

    <section class="plants-header">
        <div>
            <span class="section-label">HERB RECOGNITION</span>

            <h1>Wszystkie rośliny</h1>

            <p>Odkrywaj rośliny znajdujące się w bazie Herb Recognition.</p>

            <HerbRecognition_Web.Components.Shared.SearchBar />

            <div class="library-filter">
                <label class="switch-label">
                    <input type="checkbox"
                           class="switch-input"
                           @bind="showPending"
                           @bind:after="OnShowPendingChangedAsync" />
                    <span class="switch-slider"></span>
                    <span>Pokaż też rośliny czekające na weryfikację</span>
                </label>

                @if (showPending && isLoadingPending)
                {
                    <span class="library-filter-note">Ładowanie zgłoszeń...</span>
                }
                else if (showPending && pendingError is not null)
                {
                    <span class="library-filter-note error">@pendingError</span>
                }
                else if (showPending)
                {
                    <span class="library-filter-note">Niezweryfikowane: @pendingPlants.Count</span>
                }
            </div>
        </div>
    </section>


    @if (isLoading)
    {
        <div class="plants-status">
            <div class="loading-spinner"></div>
            <p>Ładowanie roślin...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="plants-error">
            <h2>Nie udało się pobrać roślin</h2>
            <p>@errorMessage</p>
            <button @onclick="LoadPlantsAsync">Spróbuj ponownie</button>
        </div>
    }
    else if (!Cards.Any())
    {
        <div class="plants-status">
            <h2>Brak roślin</h2>
            <p>Baza nie zawiera jeszcze żadnych roślin.</p>
        </div>
    }
    else
    {
        <section class="plants-grid">

            @foreach (var card in Cards)
            {
                <article class="plant-card @(card.IsPending ? "pending" : "")">

                    <div class="plant-card-content">

                        <div class="plant-card-top">

                            <div class="plant-pills">
                                <span class="plant-type">
                                    @(card.PlantTypeName ?? "Unknown")
                                </span>

                                @if (!string.IsNullOrEmpty(card.MonthOfHarvestName))
                                {
                                    <span class="plant-type plant-month">
                                        Zbiór: @card.MonthOfHarvestName
                                    </span>
                                }

                                @if (card.IsPending)
                                {
                                    <span class="plant-type plant-pending">Niezweryfikowana</span>
                                }
                            </div>

                            <span class="plant-id">
                                @(card.IsPending ? $"Zgłoszenie #{card.Id}" : $"#{card.Id}")
                            </span>

                        </div>

                        <h2>@card.PolishName</h2>

                        <p class="plant-name">@card.Name</p>

                        <p class="plant-latin">@card.LatinName</p>

                        @if (!string.IsNullOrWhiteSpace(card.Subriquet))
                        {
                            <p class="plant-subriquet">„@card.Subriquet”</p>
                        }

                        @if (card.IsPending)
                        {
                            <p class="plant-card-note">
                                Szczegóły będą dostępne po zweryfikowaniu zgłoszenia.
                            </p>
                        }
                        else
                        {
                            <a href="@($"/plants/{card.Id}")" class="plant-card-link">
                                Zobacz szczegóły
                                <span>→</span>
                            </a>
                        }

                    </div>

                </article>
            }

            <div class="plant-card-content">
                <p>Nie ma rośliny, której szukasz? Możesz zgłosić ją za pomocą formularza.</p>
                <a href="/plant-form" class="plant-form-button">Przejdź do formularza <span>→</span></a>
            </div>

        </section>
    }

</div>


@code {

    private List<GetPreviewPlantDTO> plants = new();
    private List<PendingPlantPreviewDTO> pendingPlants = new();

    private bool isLoading = true;
    private string? errorMessage;

    private bool showPending;
    private bool pendingLoaded;
    private bool isLoadingPending;
    private string? pendingError;

    private static readonly StringComparer PolishOrder =
        StringComparer.Create(new CultureInfo("pl-PL"), ignoreCase: true);

    // zatwierdzone + (opcjonalnie) zgłoszenia, wspólnie posortowane po nazwie polskiej
    private IEnumerable<LibraryCard> Cards =>
        plants.Select(p => new LibraryCard(
                p.Id, p.Name, p.PolishName, p.LatinName, p.Subriquet,
                p.PlantTypeDTO?.Name, p.MonthOfHarvestName, IsPending: false))
            .Concat(showPending
                ? pendingPlants.Select(p => new LibraryCard(
                    p.Id, p.Name, p.PolishName, p.LatinName, p.Subriquet,
                    p.PlantTypeName, p.MonthOfHarvestName, IsPending: true))
                : Enumerable.Empty<LibraryCard>())
            .OrderBy(c => c.PolishName, PolishOrder);

    protected override async Task OnInitializedAsync()
    {
        await LoadPlantsAsync();
    }

    private async Task LoadPlantsAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            plants = await PlantApiService.GetAllPlantsAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd pobierania roślin: {ex}");
            errorMessage = "Wystąpił problem podczas komunikacji z API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // zgłoszenia pobieramy dopiero przy pierwszym włączeniu przełącznika
    private async Task OnShowPendingChangedAsync()
    {
        if (!showPending || pendingLoaded) return;

        isLoadingPending = true;
        pendingError = null;

        try
        {
            pendingPlants = await PlantApiService.GetPendingPlantsAsync();
            pendingLoaded = true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd pobierania zgłoszeń: {ex}");
            pendingError = "Nie udało się pobrać niezweryfikowanych roślin.";
        }
        finally
        {
            isLoadingPending = false;
        }
    }

    private sealed record LibraryCard(
        int Id,
        string Name,
        string PolishName,
        string? LatinName,
        string? Subriquet,
        string? PlantTypeName,
        string? MonthOfHarvestName,
        bool IsPending);
}
