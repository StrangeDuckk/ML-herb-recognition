@page "/admin"
@using System.Text.Json
@using HerbRecognition_Web.Communication.DTOs
@using HerbRecognition_Web.Communication.Services
@using HerbRecognition_Web.Components.Shared
@inject AdminAuthService Auth
@inject AdminApiService AdminApi
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>Panel administratora</PageTitle>

<div class="plants-page admin-page">

    <AdminNav />

    <section class="plants-header admin-header">
        <div>
            <span class="section-label">PANEL ADMINISTRATORA</span>
            <h1>Zarządzanie słownikami</h1>
        </div>
    </section>

    <div class="admin-layout">

        <nav class="admin-tabs">
            @foreach (var group in Dictionaries.GroupBy(d => d.Group))
            {
                <span class="admin-tabs-group">@group.Key</span>
                @foreach (var d in group)
                {
                    <button type="button"
                            class="admin-tab @(d == current ? "active" : "")"
                            @onclick="() => SelectAsync(d)">
                        @d.Title
                    </button>
                }
            }
        </nav>

        <section class="admin-content">
            <h2>@current.Title</h2>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="admin-message @(isError ? "error" : "success")">@message</div>
            }

            @if (current.EditOnly)
            {
                <p class="admin-hint">
                    Ten słownik ma stałą liczbę wpisów – możesz tylko zmieniać ich nazwy.
                </p>
            }
            else
            {
                <div class="admin-add">
                    <input class="admin-input" placeholder="Nowa wartość..." maxlength="@current.MaxLength"
                           @bind="newItem.Name" @bind:event="oninput" />

                    @if (current.HasDescription)
                    {
                        <input class="admin-input" placeholder="@($"{current.DescriptionLabel} (opcjonalnie)")" maxlength="4000"
                               @bind="newItem.Description" @bind:event="oninput" />
                    }

                    @if (current.IsColor)
                    {
                        <input class="admin-input rgb" type="number" min="0" max="255" placeholder="R"
                               @bind="newItem.R" @bind:event="oninput" />
                        <input class="admin-input rgb" type="number" min="0" max="255" placeholder="G"
                               @bind="newItem.G" @bind:event="oninput" />
                        <input class="admin-input rgb" type="number" min="0" max="255" placeholder="B"
                               @bind="newItem.B" @bind:event="oninput" />
                        <span class="admin-swatch" style="@SwatchStyle(newItem)"></span>
                    }

                    <button type="button" class="admin-btn"
                            disabled="@(isBusy || string.IsNullOrWhiteSpace(newItem.Name))"
                            @onclick="AddAsync">
                        Dodaj
                    </button>
                </div>
            }

            @if (!isLoading && items.Count > 8)
            {
                <input class="admin-input admin-filter" type="search" placeholder="Filtruj listę..."
                       aria-label="Filtruj listę"
                       @bind="filter" @bind:event="oninput" />
            }

            @if (isLoading)
            {
                <p class="admin-empty">Ładowanie...</p>
            }
            else if (items.Count == 0)
            {
                <p class="admin-empty">Ten słownik jest pusty.</p>
            }
            else
            {
                <div class="admin-table-wrap">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Id</th>
                                @if (current.IsColor)
                                {
                                    <th></th>
                                }
                                <th>Nazwa</th>
                                @if (current.HasDescription)
                                {
                                    <th>@current.DescriptionLabel</th>
                                }
                                @if (current.IsColor)
                                {
                                    <th>R</th>
                                    <th>G</th>
                                    <th>B</th>
                                }
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Visible)
                            {
                                var isEditing = editing?.Id == item.Id;
                                var shown = isEditing ? editing! : item;

                                <tr>
                                    <td class="admin-id">@item.Id</td>

                                    @if (current.IsColor)
                                    {
                                        <td><span class="admin-swatch" style="@SwatchStyle(shown)"></span></td>
                                    }

                                    @if (isEditing)
                                    {
                                        <td>
                                            <input class="admin-input" maxlength="@current.MaxLength"
                                                   @bind="editing!.Name" @bind:event="oninput" />
                                        </td>

                                        @if (current.HasDescription)
                                        {
                                            <td>
                                                <input class="admin-input" maxlength="4000"
                                                       @bind="editing!.Description" @bind:event="oninput" />
                                            </td>
                                        }

                                        @if (current.IsColor)
                                        {
                                            <td>
                                                <input class="admin-input rgb" type="number" min="0" max="255"
                                                       @bind="editing!.R" @bind:event="oninput" />
                                            </td>
                                            <td>
                                                <input class="admin-input rgb" type="number" min="0" max="255"
                                                       @bind="editing!.G" @bind:event="oninput" />
                                            </td>
                                            <td>
                                                <input class="admin-input rgb" type="number" min="0" max="255"
                                                       @bind="editing!.B" @bind:event="oninput" />
                                            </td>
                                        }

                                        <td>
                                            <div class="admin-actions">
                                                <button type="button" class="admin-btn small"
                                                        disabled="@isBusy" @onclick="SaveAsync">
                                                    Zapisz
                                                </button>
                                                <button type="button" class="admin-btn small secondary"
                                                        @onclick="CancelEdit">
                                                    Anuluj
                                                </button>
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>@item.Name</td>

                                        @if (current.HasDescription)
                                        {
                                            <td class="admin-muted">@item.Description</td>
                                        }

                                        @if (current.IsColor)
                                        {
                                            <td>@item.R</td>
                                            <td>@item.G</td>
                                            <td>@item.B</td>
                                        }

                                        <td>
                                            <div class="admin-actions">
                                                @if (confirmDeleteId == item.Id)
                                                {
                                                    <button type="button" class="admin-btn small danger solid"
                                                            disabled="@isBusy"
                                                            @onclick="() => DeleteAsync(item.Id)">
                                                        Na pewno usuń
                                                    </button>
                                                    <button type="button" class="admin-btn small secondary"
                                                            @onclick="CancelDelete">
                                                        Anuluj
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="admin-btn small secondary"
                                                            @onclick="() => StartEdit(item)">
                                                        Edytuj
                                                    </button>
                                                    @if (!current.EditOnly)
                                                    {
                                                        <button type="button" class="admin-btn small danger"
                                                                @onclick="() => AskDelete(item.Id)">
                                                            Usuń
                                                        </button>
                                                    }
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private sealed record DictionaryDef(
        string Group,
        string Endpoint,
        string Title,
        string IdProperty,
        string NameProperty,
        int MaxLength = 100,
        bool IsColor = false,
        bool EditOnly = false,
        string? DescriptionProperty = null,
        string? DescriptionLabel = null)
    {
        public bool HasDescription => DescriptionProperty is not null;
    }

    // plantType celowo pominięty – formularz zależy od Id 1/2/3
    private static readonly DictionaryDef[] Dictionaries =
    {
        new("Rośliny", "occurance",      "Występowanie",        "occuranceId",      "occurance"),
        new("Rośliny", "shape",          "Kształty",            "shapeId",          "shapeName"),
        new("Rośliny", "flavour",        "Smaki",               "flavourId",        "flavourName"),
        new("Rośliny", "poisonability",  "Trujące właściwości", "poisonabilityId",  "poisonabilityDescription"),
        new("Rośliny", "surface",        "Powierzchnie",        "surfaceId",        "surfaceName"),
        new("Rośliny", "thickness",      "Grubości",            "thicknessId",      "thicknessName"),
        new("Rośliny", "color",          "Kolory",              "colorId",          "colorName", MaxLength: 50, IsColor: true),
        new("Rośliny", "monthOfHarvest", "Miesiąc zbioru",      "monthOfHarvestId", "monthName", EditOnly: true),

        new("Przepisy", "productType",      "Typy produktów",        "productTypeId",      "name"),
        new("Przepisy", "disease",          "Choroby",               "diseaseId",          "name", MaxLength: 300,
            DescriptionProperty: "symptoms", DescriptionLabel: "Objawy"),
        new("Przepisy", "healthProperty",   "Właściwości zdrowotne", "healthPropertyId",   "property", MaxLength: 300),
        new("Przepisy", "activeSubstance",  "Substancje czynne",     "activeSubstanceId",  "activeSubstance", MaxLength: 300),
        new("Przepisy", "contraindication", "Przeciwwskazania",      "contraindicationId", "name", MaxLength: 1000),
    };

    private DictionaryDef current = Dictionaries[0];
    private List<DictionaryItemDTO> items = new();
    private DictionaryItemDTO newItem = new();
    private DictionaryItemDTO? editing;
    private int? confirmDeleteId;
    private string filter = "";

    private bool isLoading;
    private bool isBusy;
    private bool isError;
    private string? message;

    private IEnumerable<DictionaryItemDTO> Visible =>
        string.IsNullOrWhiteSpace(filter)
            ? items
            : items.Where(i =>
                (i.Name ?? "").Contains(filter.Trim(), StringComparison.CurrentCultureIgnoreCase) ||
                (i.Description ?? "").Contains(filter.Trim(), StringComparison.CurrentCultureIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/admin/login");
            return;
        }

        await LoadAsync();
    }

    private async Task SelectAsync(DictionaryDef dictionary)
    {
        current = dictionary;
        newItem = new();
        editing = null;
        confirmDeleteId = null;
        message = null;
        filter = "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;

        try
        {
            using var response = await Http.GetAsync($"api/dictionaries/{current.Endpoint}");
            response.EnsureSuccessStatusCode();

            using var stream = await response.Content.ReadAsStreamAsync();
            using var document = await JsonDocument.ParseAsync(stream);

            items = document.RootElement.EnumerateArray()
                .Select(e => new DictionaryItemDTO
                {
                    Id = Prop(e, current.IdProperty)?.GetInt32() ?? 0,
                    Name = Prop(e, current.NameProperty)?.GetString() ?? "",
                    Description = current.DescriptionProperty is null
                        ? null
                        : Prop(e, current.DescriptionProperty)?.GetString(),
                    R = current.IsColor ? Prop(e, "colorR")?.GetInt32() ?? Prop(e, "r")?.GetInt32() : null,
                    G = current.IsColor ? Prop(e, "colorG")?.GetInt32() ?? Prop(e, "g")?.GetInt32() : null,
                    B = current.IsColor ? Prop(e, "colorB")?.GetInt32() ?? Prop(e, "b")?.GetInt32() : null
                })
                .OrderBy(i => i.Id)
                .ToList();
        }
        catch (Exception ex)
        {
            items = new();
            ShowMessage($"Nie udało się wczytać słownika: {ex.Message}", error: true);
        }
        finally
        {
            isLoading = false;
        }
    }

    private Task AddAsync()
    {
        if (!IsValid(newItem)) return Task.CompletedTask;

        return RunAsync(async () =>
        {
            await AdminApi.CreateAsync(current.Endpoint, newItem);
            newItem = new();
            await LoadAsync();
        }, "Dodano nową wartość.");
    }

    private void StartEdit(DictionaryItemDTO item)
    {
        confirmDeleteId = null;
        editing = new DictionaryItemDTO
        {
            Id = item.Id,
            Name = item.Name,
            Description = item.Description,
            R = item.R,
            G = item.G,
            B = item.B
        };
    }

    private void CancelEdit() => editing = null;

    private Task SaveAsync()
    {
        if (editing is null || !IsValid(editing)) return Task.CompletedTask;

        return RunAsync(async () =>
        {
            await AdminApi.UpdateAsync(current.Endpoint, editing);
            editing = null;
            await LoadAsync();
        }, "Zapisano zmiany.");
    }

    private void AskDelete(int id)
    {
        editing = null;
        confirmDeleteId = id;
    }

    private void CancelDelete() => confirmDeleteId = null;

    private Task DeleteAsync(int id) =>
        RunAsync(async () =>
        {
            await AdminApi.DeleteAsync(current.Endpoint, id);
            confirmDeleteId = null;
            await LoadAsync();
        }, "Usunięto wartość.");

    private async Task RunAsync(Func<Task> action, string successMessage)
    {
        isBusy = true;
        message = null;

        try
        {
            await action();
            ShowMessage(successMessage, error: false);
        }
        catch (UnauthorizedAccessException)
        {
            Auth.Logout();
            Nav.NavigateTo("/admin/login");
        }
        catch (Exception ex)
        {
            ShowMessage(ex.Message, error: true);
        }
        finally
        {
            isBusy = false;
        }
    }

    private bool IsValid(DictionaryItemDTO item)
    {
        if (string.IsNullOrWhiteSpace(item.Name))
        {
            ShowMessage("Nazwa nie może być pusta.", error: true);
            return false;
        }

        if (item.Name.Trim().Length > current.MaxLength)
        {
            ShowMessage($"Nazwa może mieć najwyżej {current.MaxLength} znaków.", error: true);
            return false;
        }

        if (current.IsColor && new[] { item.R, item.G, item.B }
                .Any(v => v is null or < 0 or > 255))
        {
            ShowMessage("Wartości R, G i B muszą być liczbami od 0 do 255.", error: true);
            return false;
        }

        return true;
    }

    private void ShowMessage(string text, bool error)
    {
        message = text;
        isError = error;
    }

    private static string SwatchStyle(DictionaryItemDTO item) =>
        $"background-color: rgb({Clamp(item.R)}, {Clamp(item.G)}, {Clamp(item.B)});";

    private static int Clamp(int? v) => Math.Clamp(v ?? 0, 0, 255);

    // wyszukiwanie pola JSON bez rozróżniania wielkości liter
    private static JsonElement? Prop(JsonElement element, string name)
    {
        foreach (var p in element.EnumerateObject())
            if (string.Equals(p.Name, name, StringComparison.OrdinalIgnoreCase))
                return p.Value;
        return null;
    }
}
