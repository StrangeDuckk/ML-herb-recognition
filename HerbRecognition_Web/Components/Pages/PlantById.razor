                    <span class="section-label">INFORMACJE</span>
                    <h2>Podstawowe informacje</h2>
                </div>

                <div class="plant-info-grid">

                    <div class="info-item">
                        <span class="info-label">Nazwa</span>
                        <span class="info-value">@plant.Name</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Nazwa polska</span>
                        <span class="info-value">@plant.PolishName</span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Nazwa łacińska</span>
