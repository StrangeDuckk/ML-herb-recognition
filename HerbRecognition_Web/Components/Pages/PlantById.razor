                    <div class="info-item">
                        <span class="info-label">Typ</span>
                        <span class="info-value">
                            @(plant.PlantTypeDTO?.Name ?? "Brak informacji")
                        </span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Występowanie</span>
                        <span class="info-value">
                            @(plant.Occurance?.Occurance ?? "Brak informacji")
                        </span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Miesiąc zbioru</span>
                        <span class="info-value">
                            @(plant.MonthOfHarvestName ?? "Brak informacji")
                        </span>
                    </div>

                    <div class="info-item">
                        <span class="info-label">Dodatkowe informacje</span>
                        <span class="info-value">
                            @(plant.MoreInfo?? "Brak informacji")
                        </span>
                    </div>

                </div>

            </section>


            @if (plant.PoisonabilityDescription is not null)
