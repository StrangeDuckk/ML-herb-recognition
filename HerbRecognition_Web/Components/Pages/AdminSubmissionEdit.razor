@page "/admin/submissions/{Id:int}"

@using HerbRecognition_Web.Communication.DTOs
@using HerbRecognition_Web.Communication.Services
@using HerbRecognition_Web.Components.Shared

@inject AdminAuthService Auth
@inject AdminApiService AdminApi
@inject NavigationManager Nav

<PageTitle>Zgłoszenie #@Id – panel administratora</PageTitle>

<div class="plants-page submission-page admin-page">

    <section class="plants-header admin-header">
        <div>
            <span class="section-label">PANEL ADMINISTRATORA</span>
            <h1>Zgłoszenie #@Id</h1>
            <p>
                Popraw dane i dodaj roślinę do bazy. Jeśli chcesz wrócić do zgłoszenia później,
                zapisz zmiany – zgłoszenie zostanie na liście.
            </p>
        </div>
        <button type="button" class="admin-btn secondary" @onclick="RedirectToLogin">Wyloguj</button>
    </section>

    <AdminNav />

    <a href="/admin/submissions" class="back-link">← Wszystkie zgłoszenia</a>

    @if (isLoading)
    {
        <div class="plants-status">
            <div class="loading-spinner"></div>
            <p>Ładowanie zgłoszenia...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <div class="plants-error">
            <h2>Nie udało się wczytać zgłoszenia</h2>
            <p>@loadError</p>
            <a href="/admin/submissions" class="submission-button">Wróć do listy zgłoszeń</a>
        </div>
    }
    else if (approvedPlantId is int plantId)
    {
        <div class="submission-success">
            <h2>Roślina dodana do bazy</h2>
            <p>
                Zgłoszenie #@Id zostało usunięte z listy, a powiązania z podobnymi roślinami
                i zgłoszeniami zostały przeniesione na nową roślinę.
            </p>
            <div class="admin-success-actions">
                <a href="@($"/plants/{plantId}")" class="submission-button">Zobacz roślinę</a>
                <a href="/admin/submissions" class="submission-button secondary">Wróć do zgłoszeń</a>
            </div>
        </div>
    }
    else if (submission is not null)
    {
        @if (!string.IsNullOrEmpty(savedMessage))
        {
            <div class="admin-message success">@savedMessage</div>
        }

        <PlantSubmissionForm @key="Id"
                             Initial="submission"
                             ExcludeUserInputId="Id"
                             SubmitText="Dodaj do bazy"
                             OnSubmit="ApproveAsync"
                             SecondaryText="Zapisz zmiany"
                             OnSecondary="SaveAsync"
                             FormName="AdminSubmissionEdit" />
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private CreatePlantDTO? submission;
    private int? approvedPlantId;

    private bool isLoading = true;
    private string? loadError;
    private string? savedMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            RedirectToLogin();
            return;
        }

        isLoading = true;
        loadError = null;
        savedMessage = null;
        approvedPlantId = null;
        submission = null;

        try
        {
            submission = await AdminApi.GetSubmissionAsync(Id);
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    // "Zapisz zmiany" – zgłoszenie zostaje w userinput
    private async Task SaveAsync(CreatePlantDTO dto)
    {
        try
        {
            await AdminApi.UpdateSubmissionAsync(Id, dto);
            savedMessage = $"Zapisano zmiany w zgłoszeniu ({DateTime.Now:HH:mm}).";
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        // pozostałe błędy pokaże formularz
    }

    // "Dodaj do bazy" – roślina trafia do bazy, zgłoszenie znika
    private async Task ApproveAsync(CreatePlantDTO dto)
    {
        try
        {
            approvedPlantId = await AdminApi.ApproveSubmissionAsync(Id, dto);
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
    }

    private void RedirectToLogin()
    {
        Auth.Logout();
        Nav.NavigateTo("/admin/login");
    }
}
