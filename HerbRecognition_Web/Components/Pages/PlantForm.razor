@page "/plant-form"

@using System.Net.Http.Json
@using System.Text.Json
@using System.ComponentModel.DataAnnotations
@using HerbRecognition_Web.Communication.DTOs
@using HerbRecognition_Web.Communication.Services
@using HerbRecognition_Web.Components.Shared

@inject HttpClient Http
@inject UserInputApiService UserInputApiService

<PageTitle>Formularz zgłoszenia rośliny</PageTitle>

<div class="plants-page submission-page">

    <section class="plants-header">
        <div>
            <span class="section-label">HERB RECOGNITION</span>
            <h1>Zgłoś nową roślinę</h1>
            <p>
                Uzupełnij informacje o roślinie.
                Zgłoszenie zostanie zweryfikowane przed dodaniem do bazy.
            </p>
        </div>
    </section>

    @if (isLoading)
    {
        <div class="plants-status">
            <div class="loading-spinner"></div>
            <p>Ładowanie słowników...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <div class="plants-error">
            <h2>Nie udało się załadować formularza</h2>
            <p>@loadError</p>
            <button type="button"
                    class="submission-button"
                    @onclick="LoadDictionariesAsync">
                Spróbuj ponownie
            </button>
        </div>
    }
    else if (submitted)
    {
        <div class="submission-success">
            <h2>Zgłoszenie zapisane!</h2>
            <p>
                Dziękujemy. Zgłoszenie oczekuje na weryfikację.
            </p>
            <p>Numer zgłoszenia: <strong>@submissionId</strong></p>
            <a href="/search" class="submission-button">
                Wróć do wyszukiwania
            </a>
        </div>
    }
    else
    {
        <EditForm Model="form" OnValidSubmit="SubmitAsync" FormName="PlantSubmitAsync"> 
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="submission-form">

                <section class="submission-section">
                    <h2>1. Informacje podstawowe</h2>

                    <div class="submission-grid">
                        <div class="submission-field">
                            <label>Nazwa zwyczajowa *</label>
                            <InputText @bind-Value="form.Name"
                                       maxlength="50" />
                            <ValidationMessage For="@(() => form.Name)" />
                        </div>

                        <div class="submission-field">
                            <label>Nazwa polska *</label>
                            <InputText @bind-Value="form.PolishName"
                                       maxlength="50" />
                            <ValidationMessage For="@(() => form.PolishName)" />
                        </div>

                        <div class="submission-field">
                            <label>Nazwa łacińska</label>
                            <InputText @bind-Value="form.LatinName"
                                       maxlength="50" />
                        </div>

                        <div class="submission-field">
                            <label>Inna nazwa</label>
                            <InputText @bind-Value="form.Subriquet"
                                       maxlength="50" />
                        </div>

                        <div class="submission-field">
                            <label>Typ rośliny *</label>
                            <InputSelect @bind-Value="form.PlantTypeID"
                                         @bind-Value:after="OnPlantTypeChanged">
                                <option value="0">Wybierz typ</option>
                                @foreach (var item in plantTypes)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => form.PlantTypeID)" />
                        </div>

                        <div class="submission-field">
                            <label>Występowanie *</label>
                            <InputSelect @bind-Value="form.OccuranceId">
                                <option value="0">Wybierz występowanie</option>
                                @foreach (var item in occurances)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => form.OccuranceId)" />
                        </div>

                        <div class="submission-field">
                            <label>Trujące właściwości</label>
                            <InputSelect @bind-Value="form.PoisonabilityId">
                                <option value="">Nie trujące</option>
                                @foreach (var item in poisonabilities)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </section>

                @if (CanHaveStalk)//switch stalk
                {
                    <div class="submission-section-toggle">
                        <label class="switch-label">
                            <span>Czy posiada @StalkSectionName.ToLower()?</span>

                            <InputCheckbox @bind-Value="HasStalk"
                                           class="switch-input" />

                            <span class="switch-slider"></span>
                        </label>
                    </div>
                }
                @if (ShowStalkSection){
                    <section class="submission-section">
                        <h2>2. @StalkSectionName</h2>
                        <p class="section-description">Wszystkie pola są wymagane.</p>

                        <div class="submission-grid">
                            <div class="submission-field">
                                <label>Kształt *</label>
                                <InputSelect @bind-Value="form.CreateStalkDTO.StalkShapeId">
                                    <option value="0">Wybierz kształt</option>
                                    @foreach (var x in shapes)
                                    {
                                        <option value="@x.Id">@x.Name</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="submission-field">
                                <label>Kolor *</label>
                                    <ColorSelect @bind-Value="form.CreateStalkDTO.StalkColorId" Colors="colors"/>
                            </div>

                            <div class="submission-field">
                                <label>Powierzchnia *</label>
                                <InputSelect @bind-Value="form.CreateStalkDTO.StalkSurfaceId">
                                    <option value="0">Wybierz powierzchnię</option>
                                    @foreach (var x in surfaces)
                                    {
                                        <option value="@x.Id">@x.Name</option>
                                    }
                                </InputSelect>
                            </div>

                            <div class="submission-field">
                                <label class="switch-label">
                                    <span>Czy łodyga jest pusta w środku?</span>
                                    <InputCheckbox @bind-Value="stalkHollow" class="switch-input" />
                                    <span class="switch-slider"></span>
                                </label>
                            </div>
                        </div>
                    </section>
                }

                @if (CanHaveSap)//switch sap
                {
                    <div class="submission-section-toggle">
                        <label class="switch-label">
                            <span>Czy posiada sok?</span>

                            <InputCheckbox @bind-Value="HasSap"
                                           class="switch-input" />

                            <span class="switch-slider"></span>
                        </label>
                    </div>
                }
                @if (ShowSapSection){
                    <section class="submission-section">
                        <h2>3. Sok</h2>
                        <div class="submission-grid">
                            <div class="submission-field">
                                <label>Kolor soku *</label>
                                <ColorSelect @bind-Value="form.CreateSapDTO!.SapColorId" Colors="colors" />
                            </div>

                            <div class="submission-field">
                                <label class="switch-label">
                                    <span>Czy sok pozostawia plamy?</span>
                                    <InputCheckbox @bind-Value="sapLeavesStain" class="switch-input" />
                                    <span class="switch-slider"></span>
                                </label>
                            </div>

                            <div class="submission-field">
                                <label class="switch-label">
                                    <span>Czy sok jest lepki?</span>
                                    <InputCheckbox @bind-Value="sapSticky" class="switch-input" />
                                    <span class="switch-slider"></span>
                                </label>
                            </div>
                        </div>
                    </section>
                }

                @if (CanHaveRoot)//switch Root
                {
                    <div class="submission-section-toggle">
                        <label class="switch-label">
                            <span>Czy posiada korzeń?</span>

                            <InputCheckbox @bind-Value="HasRoot"
                                           class="switch-input" />

                            <span class="switch-slider"></span>
                        </label>
                    </div>
                }
                @if (ShowRootSection){
                    <section class="submission-section">
                        <h2>4. Korzeń</h2>
                        <div class="submission-grid">
                            <div class="submission-field">
                                <label>Kolor korzenia *</label>
                                <ColorSelect @bind-Value="form.CreateRootDTO!.RootColorId" Colors="colors" />
                            </div>
                            <div class="submission-field">
                                <label>Powierzchnia *</label>
                                <InputSelect @bind-Value="form.CreateRootDTO!.RootSurfaceId">
                                    <option value="0">Wybierz powierzchnię</option>
                                    @foreach (var x in surfaces)
                                    {
                                        <option value="@x.Id">@x.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="submission-field">
                                <label>Grubość *</label>
                                <InputSelect @bind-Value="form.CreateRootDTO!.RootThicknessId">
                                    <option value="0">Wybierz grubość</option>
                                    @foreach (var x in thicknesses)
                                    {
                                        <option value="@x.Id">@x.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="submission-field">
                                <label class="switch-label">
                                    <span>Czy jest pusty w środku?</span>
                                    <InputCheckbox @bind-Value="rootIsHollow" class="switch-input" />
                                    <span class="switch-slider"></span>
                                </label>
                            </div>
                        </div>
                    </section>
                }

                @if (CanHaveHat)//switch Hat
                {
                    <div class="submission-section-toggle">
                        <label class="switch-label">
                            <span>Czy posiada kapelusz?</span>

                            <InputCheckbox @bind-Value="HasHat"
                                           class="switch-input" />

                            <span class="switch-slider"></span>
                        </label>
                    </div>
                }
                @if (ShowHatSection){
                    <section class="submission-section">
                        <h2>5. Kapelusz</h2>
                        <div class="submission-grid">
                            <div class="submission-field">
                                <label>Kolor kapelusza *</label>
                                <ColorSelect @bind-Value="form.CreateHatDTO!.HatColorId" Colors="colors" />
                            </div>
                            <div class="submission-field">
                                <label>Kształt *</label>
                                <InputSelect @bind-Value="form.CreateHatDTO!.HatShapeId">
                                    <option value="0">Wybierz kształt</option>
                                    @foreach (var x in shapes)
                                    {
                                        <option value="@x.Id">@x.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="submission-field">
                                <label>Grubość *</label>
                                <InputSelect @bind-Value="form.CreateHatDTO!.HatThicknessId">
                                    <option value="0">Wybierz grubość</option>
                                    @foreach (var x in thicknesses)
                                    {
                                        <option value="@x.Id">@x.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="submission-field">
                                <label>Powierzchnia *</label>
                                <InputSelect @bind-Value="form.CreateHatDTO!.HatSurfaceId">
                                    <option value="0">Wybierz powierzchnię</option>
                                    @foreach (var x in surfaces)
                                    {
                                        <option value="@x.Id">@x.Name</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="submission-field">
                                <label class="switch-label">
                                    <span>Czy ma plamy na kapeluszu?</span>
                                    <InputCheckbox @bind-Value="hatHasSpots" class="switch-input" />
                                    <span class="switch-slider"></span>
                                </label>
                            </div>
                            <div class="submission-field">
                                <label class="switch-label">
                                    <span>Czy ma blaszki?</span>
                                    <InputCheckbox @bind-Value="hatHasGills" class="switch-input" />
                                    <span class="switch-slider"></span>
                                </label>
                            </div>
                            <div class="submission-field">
                                <label class="switch-label">
                                    <span>Czy ma pierścień?</span>
                                    <InputCheckbox @bind-Value="hatHasRing" class="switch-input" />
                                    <span class="switch-slider"></span>
                                </label>
                            </div>
                        </div>
                    </section>
                }

                @if (CanHaveLeaf)//switch Leaf
                {
                    <div class="submission-section-toggle">
                        <label class="switch-label">
                            <span>Czy posiada liście?</span>

                            <InputCheckbox @bind-Value="HasLeaf"
                                           class="switch-input" />

                            <span class="switch-slider"></span>
                        </label>
                    </div>
                }
                @if (ShowLeafSection){
                <section class="submission-section">
                    <h2>6. Liście</h2>
                    <div class="submission-grid">
                        <div class="submission-field">
                            <label>Kształt *</label>
                            <InputSelect @bind-Value="form.CreateLeafDTO!.LeafShapeId">
                                <option value="0">Wybierz kształt</option>
                                @foreach (var x in shapes)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                                <label>Kolor liścia *</label>
                                <ColorSelect @bind-Value="form.CreateLeafDTO!.LeafColorId" Colors="colors" />
                        </div>
                        <div class="submission-field">
                            <label>Powierzchnia *</label>
                            <InputSelect @bind-Value="form.CreateLeafDTO!.LeafSurfaceId">
                                <option value="0">Wybierz powierzchnię</option>
                                @foreach (var x in surfaces)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Grubość *</label>
                            <InputSelect @bind-Value="form.CreateLeafDTO!.LeafThicknessId">
                                <option value="0">Wybierz grubość</option>
                                @foreach (var x in thicknesses)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Smak *</label>
                            <InputSelect @bind-Value="form.CreateLeafDTO!.LeafFlavourId">
                                <option value="">Wybierz smak</option>
                                @foreach (var x in flavours)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Długość liścia (cm) *</label>
                            <InputNumber @bind-Value="form.CreateLeafDTO!.LeafLength" min="0.1" />
                        </div>
                        <div class="submission-field">
                            <label class="switch-label">
                                    <span>Czy ma paski?</span>
                                    <InputCheckbox @bind-Value="leafStripes" class="switch-input" />
                                    <span class="switch-slider"></span>
                            </label>
                        </div>
                        <div class="submission-field">
                            <label class="switch-label">
                                    <span>Czy ma plamy?</span>
                                    <InputCheckbox @bind-Value="leafSpots" class="switch-input" />
                                    <span class="switch-slider"></span>
                            </label>
                        </div>
                        <div class="submission-field">
                            <label class="switch-label">
                                    <span>Czy ma otwory?</span>
                                    <InputCheckbox @bind-Value="leafHoles" class="switch-input" />
                                    <span class="switch-slider"></span>
                            </label>
                        </div>
                    </div>
                </section>
                }

                @if (CanHaveFlower)//switch Flower
                {
                    <div class="submission-section-toggle">
                        <label class="switch-label">
                            <span>Czy posiada kwiaty?</span>

                            <InputCheckbox @bind-Value="HasFlower"
                                           class="switch-input" />

                            <span class="switch-slider"></span>
                        </label>
                    </div>
                }
                @if(ShowFlowerSection){
                <section class="submission-section">
                    <h2>7. Kwiaty</h2>
                    <div class="submission-grid">
                        <div class="submission-field">
                            <label>Rozmiar kwiatu (cm) *</label>
                            <InputNumber @bind-Value="form.CreateFlowerDTO!.FlowerSizeInCm" min="0.1" />
                        </div>
                        <div class="submission-field">
                                <label>Kolor główny kwiatu*</label>
                                <ColorSelect @bind-Value="form.CreateFlowerDTO!.FlowerColorId" Colors="colors" />
                        </div>
                        <div class="submission-field">
                            <label>Kształt *</label>
                            <InputSelect @bind-Value="form.CreateFlowerDTO!.FlowerShapeId">
                                <option value="0">Wybierz kształt</option>
                                @foreach (var x in shapes)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Smak *</label>
                            <InputSelect @bind-Value="form.CreateFlowerDTO!.FlowerFlavourId">
                                <option value="">Wybierz smak</option>
                                @foreach (var x in flavours)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Siła zapachu (0–5) *</label>
                            <InputSelect @bind-Value="form.CreateFlowerDTO!.FlowerScentPower">
                                @for (var i = 0; i <= 5; i++)
                                {
                                    <option value="@i">@i</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </section>
                }

                @if (CanHaveFruit)//switch Fruit
                {
                    <div class="submission-section-toggle">
                        <label class="switch-label">
                            <span>Czy posiada owoce?</span>

                            <InputCheckbox @bind-Value="HasFruit"
                                           class="switch-input" />

                            <span class="switch-slider"></span>
                        </label>
                    </div>
                }
                @if(ShowFruitSection){
                <section class="submission-section">
                    <h2>8. Owoce</h2>
                    <div class="submission-grid">
                        <div class="submission-field">
                            <label>Smak *</label>
                            <InputSelect @bind-Value="form.CreateFruitDTO!.FruitFlavourId">
                                <option value="">Wybierz smak</option>
                                @foreach (var x in flavours)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Kształt *</label>
                            <InputSelect @bind-Value="form.CreateFruitDTO!.FruitShapeId">
                                <option value="0">Wybierz kształt</option>
                                @foreach (var x in shapes)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                                <label>Kolor główny owocu*</label>
                                <ColorSelect @bind-Value="form.CreateFruitDTO!.FruitColorId" Colors="colors" />
                        </div>
                        <div class="submission-field">
                            <label>Powierzchnia *</label>
                            <InputSelect @bind-Value="form.CreateFruitDTO!.FruitSurfaceId">
                                <option value="0">Wybierz powierzchnię</option>
                                @foreach (var x in surfaces)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Grubość *</label>
                            <InputSelect @bind-Value="form.CreateFruitDTO!.FruitThicknessId">
                                <option value="0">Wybierz grubość</option>
                                @foreach (var x in thicknesses)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </section>
                }

                @if (!string.IsNullOrWhiteSpace(submitError))
                {
                    <div class="plants-error">
                        @submitError
                    </div>
                }

                <div class="submission-actions">
                    <button type="submit"
                            class="submission-button"
                            disabled="@isSubmitting">
                        @(isSubmitting ? "Zapisywanie..." : "Wyślij zgłoszenie")
                    </button>
                </div>

            </div>
        </EditForm>
    }
</div>

@code {
    private CreatePlantDTO form = new();

    private bool IsTree => form.PlantTypeID == 1;
    private bool IsHerb => form.PlantTypeID == 2;
    private bool IsFungus => form.PlantTypeID == 3;

    private string StalkSectionName => IsTree ? "Pień" : IsFungus ? "Trzon" : "Łodyga";

    //switche dla sekcji
    private bool HasStalk;
    private bool HasSap;
    private bool HasRoot;
    private bool HasHat;
    private bool HasLeaf;
    private bool HasFlower;
    private bool HasFruit;

    //show hide sekcje na podstawie planttype
    private bool CanHaveStalk => IsTree || IsHerb || IsFungus; // 2
    private bool CanHaveSap => IsTree || IsHerb || IsFungus; //3
    private bool CanHaveRoot => IsTree || IsHerb; //4
    private bool CanHaveHat => IsFungus; //5
    private bool CanHaveLeaf => IsTree || IsHerb; //6
    private bool CanHaveFlower => IsTree || IsHerb; //7
    private bool CanHaveFruit => IsTree || IsHerb; //8

    //rzeczywista widocznosc sekcji
    private bool ShowStalkSection => CanHaveStalk && HasStalk;
    private bool ShowSapSection => CanHaveSap && HasSap;
    private bool ShowRootSection => CanHaveRoot && HasRoot;
    private bool ShowHatSection => CanHaveHat && HasHat;
    private bool ShowLeafSection => CanHaveLeaf && HasLeaf;
    private bool ShowFlowerSection => CanHaveFlower && HasFlower;
    private bool ShowFruitSection => CanHaveFruit && HasFruit;

    private List<DictionaryOption> plantTypes = new();
    private List<DictionaryOption> occurances = new();
    private List<DictionaryOption> shapes = new();
    private List<DictionaryOption> flavours = new();
    private List<DictionaryOption> poisonabilities = new();
    private List<DictionaryOption> surfaces = new();
    private List<DictionaryOption> thicknesses = new();
    private List<ColorOption> colors = new();

    private bool stalkHollow;
    private bool sapLeavesStain;
    private bool sapSticky;
    private bool hatHasSpots;
    private bool hatHasGills;
    private bool hatHasRing;
    private bool leafStripes;
    private bool leafSpots;
    private bool leafHoles;
    private bool rootIsHollow;

    private bool isLoading = true;
    private bool isSubmitting;
    private bool submitted;
    private string? loadError;
    private string? submitError;
    private int submissionId;

    //private void OnNameInput(ChangeEventArgs e) { form.Name = e.Value?.ToString() ?? string.Empty; Console.WriteLine($"Wpisana nazwa: [{form.Name}]"); }

    protected override async Task OnInitializedAsync()
    {
        InitializeForm();
        await LoadDictionariesAsync();
    }

    private void InitializeForm()
    {
        form.CreateStalkDTO = new();
        form.CreateSapDTO = new();
        form.CreateRootDTO = new();
        form.CreateHatDTO = new();
        form.CreateLeafDTO = new();
        form.CreateFlowerDTO = new();
        form.CreateFruitDTO = new();
    }

    private void OnPlantTypeChanged()
    {
        // Drzewo
        if (IsTree)
        {
            HasStalk = true;
            HasSap = true;
            HasRoot = true;
            HasHat = false;
            HasLeaf = true;
            HasFlower = true;
            HasFruit = true;
        }
        // Zioło
        else if (IsHerb)
        {
            HasStalk = true;
            HasSap = true;
            HasRoot = true;
            HasHat = false;
            HasLeaf = true;
            HasFlower = true;
            HasFruit = true;
        }
        // Grzyb
        else if (IsFungus)
        {
            HasStalk = true;
            HasSap = true;
            HasRoot = false;
            HasHat = true;
            HasLeaf = false;
            HasFlower = false;
            HasFruit = false;
        }
        // Nie wybrano typu
        else
        {
            HasStalk = false;
            HasSap = false;
            HasRoot = false;
            HasHat = false;
            HasLeaf = false;
            HasFlower = false;
            HasFruit = false;
        }

        submitError = null;
    }

    private async Task LoadDictionariesAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            plantTypes = await LoadOptionsAsync("plantType", "plantTypeId", "name");
            occurances = await LoadOptionsAsync("occurance", "occuranceId", "occurance");
            shapes = await LoadOptionsAsync("shape", "shapeId", "shapeName");
            flavours = await LoadOptionsAsync("flavour", "flavourId" , "flavourName");
            poisonabilities = await LoadOptionsAsync("poisonability", "poisonabilityId", "poisonabilityDescription");
            surfaces = await LoadOptionsAsync("surface", "surfaceId", "surfaceName");
            thicknesses = await LoadOptionsAsync("thickness", "thicknessId", "thicknessName");
            colors = await LoadColorsAsync();
        }
        // catch (Exception)
        // {
        //     loadError =
        //         "Nie udało się pobrać danych słownikowych z API. " +
        //         "Sprawdź połączenie i spróbuj ponownie.";
        // }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd ładowania słowników: {ex}");

            loadError = ex switch
            {
                HttpRequestException httpEx =>
                    $"Błąd HTTP lub połączenia z API: {httpEx.Message}",

                JsonException jsonEx =>
                    $"Nieprawidłowy format JSON: {jsonEx.Message}",

                InvalidOperationException invalidEx =>
                    $"Nieprawidłowe dane słownika: {invalidEx.Message}",

                _ => $"Nieoczekiwany błąd: {ex.Message}"
            };

        }

        finally
        {
            isLoading = false;
        }
    }

    private async Task<List<DictionaryOption>> LoadOptionsAsync(
        string endpoint, string idPropertyName, string nameProperty)
    {
        Console.WriteLine( $"HttpClient BaseAddress: {Http.BaseAddress}");

        using var response = await Http.GetAsync(
            $"api/dictionaries/{endpoint}");

        response.EnsureSuccessStatusCode();

        using var stream = await response.Content.ReadAsStreamAsync();
        using var document = await JsonDocument.ParseAsync(stream);

        if (document.RootElement.ValueKind != JsonValueKind.Array) 
        { 
            throw new InvalidOperationException($"Słownik {endpoint} nie zwraca tablicy JSON."); 
        }

        var result = new List<DictionaryOption>();

        foreach (var element in document.RootElement.EnumerateArray())
        {
            if (!element.TryGetProperty(idPropertyName, out var idProperty))
                throw new InvalidOperationException(
                    $"Brak pola klucza {idPropertyName} w słowniku {endpoint}.");

            if (!element.TryGetProperty(nameProperty, out var namePropertyValue))
                throw new InvalidOperationException(
                    $"Brak pola {nameProperty} w słowniku {endpoint}.");

            result.Add(new DictionaryOption
            {
                Id = idProperty.GetInt32(),
                Name = namePropertyValue.GetString() ?? ""
            });
        }

        return result;
    }

    private async Task<List<ColorOption>> LoadColorsAsync()
    {
        using var response = await Http.GetAsync("api/dictionaries/color");
        response.EnsureSuccessStatusCode();

        using var stream = await response.Content.ReadAsStreamAsync();
        using var document = await JsonDocument.ParseAsync(stream);

        return document.RootElement.EnumerateArray()
            .Select(e => new ColorOption
            {
                Id = e.GetProperty("colorId").GetInt32(),
                Name = e.GetProperty("colorName").GetString() ?? "",
                R = e.GetProperty("colorR").GetInt32(),
                G = e.GetProperty("colorG").GetInt32(),
                B = e.GetProperty("colorB").GetInt32()
            })
            .ToList();
    }

    private async Task SubmitAsync()
    {
        submitError = null;

        bool plantPartsInvalid = form.PlantTypeID <= 0 || form.OccuranceId <= 0;

        //walidacja po regionach
        if (ShowStalkSection)
        {
            plantPartsInvalid |= form.CreateStalkDTO!.StalkShapeId <= 0
                    || form.CreateStalkDTO.StalkColorId <= 0
                    || form.CreateStalkDTO.StalkSurfaceId <= 0;
        }
        if (ShowSapSection)
        {
            plantPartsInvalid |= form.CreateSapDTO!.SapColorId <= 0;
        }
        if (ShowHatSection)
        {
            plantPartsInvalid |=
                form.CreateHatDTO!.HatColorId <= 0 ||
                form.CreateHatDTO.HatShapeId <= 0 ||
                form.CreateHatDTO.HatThicknessId <= 0 ||
                form.CreateHatDTO.HatSurfaceId <= 0;
        }
        if (ShowRootSection)
        {
            plantPartsInvalid |=
                form.CreateRootDTO!.RootColorId <= 0 ||
                form.CreateRootDTO.RootSurfaceId <= 0 ||
                form.CreateRootDTO.RootThicknessId <= 0;
        }
        if (ShowLeafSection)
        {
            plantPartsInvalid |=
                form.CreateLeafDTO!.LeafShapeId <= 0 ||
                form.CreateLeafDTO.LeafColorId <= 0 ||
                form.CreateLeafDTO.LeafSurfaceId <= 0 ||
                form.CreateLeafDTO.LeafThicknessId <= 0 ||
                !form.CreateLeafDTO.LeafFlavourId.HasValue;
        }
        if (ShowFlowerSection)
        {
            plantPartsInvalid |=
                form.CreateFlowerDTO!.FlowerColorId <= 0 ||
                form.CreateFlowerDTO.FlowerShapeId <= 0 ||
                !form.CreateFlowerDTO.FlowerFlavourId.HasValue;
        }
        if (ShowFruitSection)
        {
            plantPartsInvalid |=
                !form.CreateFruitDTO!.FruitFlavourId.HasValue ||
                form.CreateFruitDTO.FruitShapeId <= 0 ||
                form.CreateFruitDTO.FruitColorId <= 0 ||
                form.CreateFruitDTO.FruitSurfaceId <= 0 ||
                form.CreateFruitDTO.FruitThicknessId <= 0;
        }
        if (plantPartsInvalid)
        {
            submitError = "Uzupełnij wszystkie wymagane pola widocznych sekcji.";
            return;
        }

        try
        {
            isSubmitting = true;
            var payload = BuildPayload();
            Console.WriteLine(JsonSerializer.Serialize(payload));
            submissionId = await UserInputApiService.PostUserInputPlantAsync(payload);
            // submissionId = await UserInputApiService.PostUserInputPlantAsync(BuildPayload());
            submitted = true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd zapisu zgłoszenia: {ex}");

            submitError = $"Nie udało się zapisać zgłoszenia: {ex.Message}";

            // submitError =
            //     "Nie udało się zapisać zgłoszenia. " +
            //     "Sprawdź połączenie z API i spróbuj ponownie.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

