                    <div class="submission-grid">
                        <div class="submission-field">
                            <label>Kształt *</label>
                            <InputSelect @bind-Value="form.CreateLeafDTO!.LeafShapeId">
                                <option value="0">Wybierz kształt</option>
                                @foreach (var x in shapes)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Kolor *</label>
                            <InputSelect @bind-Value="form.CreateLeafDTO!.LeafColorId">
                                <option value="0">Wybierz kolor</option>
                                @foreach (var x in colors)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Powierzchnia *</label>
                            <InputSelect @bind-Value="form.CreateLeafDTO!.LeafSurfaceId">
                                <option value="0">Wybierz powierzchnię</option>
                                @foreach (var x in surfaces)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Grubość *</label>
                            <InputSelect @bind-Value="form.CreateLeafDTO!.LeafThicknessId">
                                <option value="0">Wybierz grubość</option>
                                @foreach (var x in thicknesses)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Smak *</label>
                            <InputSelect @bind-Value="form.CreateLeafDTO!.LeafFlavourId">
                                <option value="">Wybierz smak</option>
                                @foreach (var x in flavours)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Długość liścia (cm) *</label>
                            <InputNumber @bind-Value="form.CreateLeafDTO!.LeafLength" min="0.1" />
                        </div>
                        <div class="submission-field">
                            <label>Czy ma paski? *</label>
                            <InputSelect @bind-Value="leafStripes">
                                <option value="">Wybierz odpowiedź</option>
                                <option value="true">Tak</option>
                                <option value="false">Nie</option>
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Czy ma plamy? *</label>
                            <InputSelect @bind-Value="leafSpots">
                                <option value="">Wybierz odpowiedź</option>
                                <option value="true">Tak</option>
                                <option value="false">Nie</option>
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Czy ma otwory? *</label>
                            <InputSelect @bind-Value="leafHoles">
                                <option value="">Wybierz odpowiedź</option>
                                <option value="true">Tak</option>
                                <option value="false">Nie</option>
                            </InputSelect>
                        </div>
                    </div>
                </section>

                <section class="submission-section">
                    <h2>7. Kwiaty</h2>
                    <div class="submission-grid">
                        <div class="submission-field">
                            <label>Rozmiar kwiatu (cm) *</label>
                            <InputNumber @bind-Value="form.CreateFlowerDTO!.FlowerSizeInCm" min="0.1" />
                        </div>
                        <div class="submission-field">
                            <label>Kolor *</label>
                            <InputSelect @bind-Value="form.CreateFlowerDTO!.FlowerColorId">
                                <option value="0">Wybierz kolor</option>
                                @foreach (var x in colors)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Kształt *</label>
                            <InputSelect @bind-Value="form.CreateFlowerDTO!.FlowerShapeId">
                                <option value="0">Wybierz kształt</option>
                                @foreach (var x in shapes)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Smak *</label>
                            <InputSelect @bind-Value="form.CreateFlowerDTO!.FlowerFlavourId">
                                <option value="">Wybierz smak</option>
                                @foreach (var x in flavours)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
