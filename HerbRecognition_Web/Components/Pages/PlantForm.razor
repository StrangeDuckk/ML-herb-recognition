@page "/plant-form"

@using System.Net.Http.Json
@using System.Text.Json
@using System.ComponentModel.DataAnnotations
@using HerbRecognition_Web.Communication.DTOs
@using HerbRecognition_Web.Communication.Services

@inject HttpClient Http
@inject UserInputApiService UserInputApiService

<PageTitle>Formularz zgłoszenia rośliny</PageTitle>

<div class="plants-page submission-page">

    <section class="plants-header">
        <div>
            <span class="section-label">HERB RECOGNITION</span>
            <h1>Zgłoś nową roślinę</h1>
            <p>
                Uzupełnij informacje o roślinie.
                Zgłoszenie zostanie zweryfikowane przed dodaniem do bazy.
            </p>
        </div>
    </section>

    @if (isLoading)
    {
        <div class="plants-status">
            <div class="loading-spinner"></div>
            <p>Ładowanie słowników...</p>
        </div>
    }
    else if (!string.IsNullOrEmpty(loadError))
    {
        <div class="plants-error">
            <h2>Nie udało się załadować formularza</h2>
            <p>@loadError</p>
            <button type="button"
                    class="submission-button"
                    @onclick="LoadDictionariesAsync">
                Spróbuj ponownie
            </button>
        </div>
    }
    else if (submitted)
    {
        <div class="submission-success">
            <h2>Zgłoszenie zapisane!</h2>
            <p>
                Dziękujemy. Zgłoszenie oczekuje na weryfikację.
            </p>
            <p>Numer zgłoszenia: <strong>@submissionId</strong></p>
            <a href="/search" class="submission-button">
                Wróć do wyszukiwania
            </a>
        </div>
    }
    else
    {
        <EditForm Model="form" OnValidSubmit="SubmitAsync" FormName="PlantSubmitAsync"> 
            <DataAnnotationsValidator />
            <ObjectGraphDataAnnotationsValidator />
            <ValidationSummary />

            <div class="submission-form">

                <section class="submission-section">
                    <h2>1. Informacje podstawowe</h2>

                    <div class="submission-grid">
                        <div class="submission-field">
                            <label>Nazwa zwyczajowa *</label>
                            <InputText @bind-Value="form.Name"
                                       maxlength="50" />
                            <ValidationMessage For="@(() => form.Name)" />
                        </div>

                        <div class="submission-field">
                            <label>Nazwa polska *</label>
                            <InputText @bind-Value="form.PolishName"
                                       maxlength="50" />
                            <ValidationMessage For="@(() => form.PolishName)" />
                        </div>

                        <div class="submission-field">
                            <label>Nazwa łacińska</label>
                            <InputText @bind-Value="form.LatinName"
                                       maxlength="50" />
                        </div>

                        <div class="submission-field">
                            <label>Inna nazwa</label>
                            <InputText @bind-Value="form.Subriquet"
                                       maxlength="50" />
                        </div>

                        <div class="submission-field">
                            <label>Typ rośliny *</label>
                            <InputSelect @bind-Value="form.PlantTypeID">
                                <option value="0">Wybierz typ</option>
                                @foreach (var item in plantTypes)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => form.PlantTypeID)" />
                        </div>

                        <div class="submission-field">
                            <label>Występowanie *</label>
                            <InputSelect @bind-Value="form.OccuranceId">
                                <option value="0">Wybierz występowanie</option>
                                @foreach (var item in occurances)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => form.OccuranceId)" />
                        </div>

                        <div class="submission-field">
                            <label>Trujące właściwości</label>
                            <InputSelect @bind-Value="form.PoisonabilityId">
                                <option value="">Nie wiem</option>
                                @foreach (var item in poisonabilities)
                                {
                                    <option value="@item.Id">@item.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </section>

                <section class="submission-section">
                    <h2>2. Łodyga</h2>
                    <p class="section-description">Wszystkie pola są wymagane.</p>

                    <div class="submission-grid">
                        <div class="submission-field">
                            <label>Kształt *</label>
                            <InputSelect @bind-Value="form.CreateStalkDTO.StalkShapeId">
                                <option value="0">Wybierz kształt</option>
                                @foreach (var x in shapes)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="submission-field">
                            <label>Kolor *</label>
                            <InputSelect @bind-Value="form.CreateStalkDTO.StalkColorId">
                                <option value="0">Wybierz kolor</option>
                                @foreach (var x in colors)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="submission-field">
                            <label>Powierzchnia *</label>
                            <InputSelect @bind-Value="form.CreateStalkDTO.StalkSurfaceId">
                                <option value="0">Wybierz powierzchnię</option>
                                @foreach (var x in surfaces)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="submission-field">
                            <label>Czy łodyga jest pusta w środku? *</label>
                            <InputSelect @bind-Value="stalkHollow">
                                <option value="">Wybierz odpowiedź</option>
                                <option value="true">Tak</option>
                                <option value="false">Nie</option>
                            </InputSelect>
                        </div>
                    </div>
                </section>

                <section class="submission-section">
                    <h2>3. Sok</h2>
                    <div class="submission-grid">
                        <div class="submission-field">
                            <label>Kolor soku *</label>
                            <InputSelect @bind-Value="form.CreateSapDTO!.SapColorId">
                                <option value="0">Wybierz kolor</option>
                                @foreach (var x in colors)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="submission-field">
                            <label>Czy sok pozostawia plamy? *</label>
                            <InputSelect @bind-Value="sapLeavesStain">
                                <option value="">Wybierz odpowiedź</option>
                                <option value="true">Tak</option>
                                <option value="false">Nie</option>
                            </InputSelect>
                        </div>

                        <div class="submission-field">
                            <label>Czy sok jest lepki? *</label>
                            <InputSelect @bind-Value="sapSticky">
                                <option value="">Wybierz odpowiedź</option>
                                <option value="true">Tak</option>
                                <option value="false">Nie</option>
                            </InputSelect>
                        </div>
                    </div>
                </section>

                <section class="submission-section">
                    <h2>4. Korzeń</h2>
                    <div class="submission-grid">
                        <div class="submission-field">
                            <label>Kolor *</label>
                            <InputSelect @bind-Value="form.CreateRootDTO!.RootColorId">
                                <option value="0">Wybierz kolor</option>
                                @foreach (var x in colors)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Powierzchnia *</label>
                            <InputSelect @bind-Value="form.CreateRootDTO!.RootSurfaceId">
                                <option value="0">Wybierz powierzchnię</option>
                                @foreach (var x in surfaces)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Grubość *</label>
                            <InputSelect @bind-Value="form.CreateRootDTO!.RootThicknessId">
                                <option value="0">Wybierz grubość</option>
                                @foreach (var x in thicknesses)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                    </div>
                </section>

                <section class="submission-section">
                    <h2>5. Kapelusz</h2>
                    <div class="submission-grid">
                        <div class="submission-field">
                            <label>Kolor *</label>
                            <InputSelect @bind-Value="form.CreateHatDTO!.HatColorId">
                                <option value="0">Wybierz kolor</option>
                                @foreach (var x in colors)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Kształt *</label>
                            <InputSelect @bind-Value="form.CreateHatDTO!.HatShapeId">
                                <option value="0">Wybierz kształt</option>
                                @foreach (var x in shapes)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Grubość *</label>
                            <InputSelect @bind-Value="form.CreateHatDTO!.HatThicknessId">
                                <option value="0">Wybierz grubość</option>
                                @foreach (var x in thicknesses)
                                {
