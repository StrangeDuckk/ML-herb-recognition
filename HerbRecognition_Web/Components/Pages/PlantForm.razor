</div>

@code {
    private CreatePlantDTO form = new();

    private List<DictionaryOption> plantTypes = new();
    private List<DictionaryOption> occurances = new();
    private List<DictionaryOption> shapes = new();
    private List<DictionaryOption> flavours = new();
    private List<DictionaryOption> poisonabilities = new();
    private List<DictionaryOption> surfaces = new();
    private List<DictionaryOption> thicknesses = new();
    private List<DictionaryOption> colors = new();

    private bool? stalkHollow;
    private bool? sapLeavesStain;
    private bool? sapSticky;
    private bool? hatHasSpots;
    private bool? hatHasGills;
    private bool? hatHasRing;
    private bool? leafStripes;
    private bool? leafSpots;
    private bool? leafHoles;

    private bool isLoading = true;
    private bool isSubmitting;
    private bool submitted;
    private string? loadError;
    private string? submitError;
    private int submissionId;

    private void OnNameInput(ChangeEventArgs e) { form.Name = e.Value?.ToString() ?? string.Empty; Console.WriteLine($"Wpisana nazwa: [{form.Name}]"); }

    protected override async Task OnInitializedAsync()
    {
        InitializeForm();
        await LoadDictionariesAsync();
    }

    private void InitializeForm()
    {
        form.CreateStalkDTO = new();
        form.CreateSapDTO = new();
        form.CreateRootDTO = new();
        form.CreateHatDTO = new();
        form.CreateLeafDTO = new();
        form.CreateFlowerDTO = new();
        form.CreateFruitDTO = new();
    }

    private async Task LoadDictionariesAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            plantTypes = await LoadOptionsAsync("plantType", "plantTypeId", "name");
            occurances = await LoadOptionsAsync("occurance", "occuranceId", "occurance");
            shapes = await LoadOptionsAsync("shape", "shapeId", "shapeName");
            flavours = await LoadOptionsAsync("flavour", "flavourId" , "flavourName");
            poisonabilities = await LoadOptionsAsync("poisonability", "poisonabilityId", "poisonabilityDescription");
            surfaces = await LoadOptionsAsync("surface", "surfaceId", "surfaceName");
            thicknesses = await LoadOptionsAsync("thickness", "thicknessId", "thicknessName");
            colors = await LoadOptionsAsync("color", "colorId", "colorName");
        }
        // catch (Exception)
        // {
        //     loadError =
        //         "Nie udało się pobrać danych słownikowych z API. " +
        //         "Sprawdź połączenie i spróbuj ponownie.";
        // }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd ładowania słowników: {ex}");

            loadError = ex switch
            {
                HttpRequestException httpEx =>
                    $"Błąd HTTP lub połączenia z API: {httpEx.Message}",

                JsonException jsonEx =>
                    $"Nieprawidłowy format JSON: {jsonEx.Message}",

                InvalidOperationException invalidEx =>
                    $"Nieprawidłowe dane słownika: {invalidEx.Message}",

                _ => $"Nieoczekiwany błąd: {ex.Message}"
            };

        }

        finally
        {
            isLoading = false;
        }
    }

    private async Task<List<DictionaryOption>> LoadOptionsAsync(
        string endpoint, string idPropertyName, string nameProperty)
    {
        Console.WriteLine( $"HttpClient BaseAddress: {Http.BaseAddress}");

        using var response = await Http.GetAsync(
            $"api/dictionaries/{endpoint}");

        response.EnsureSuccessStatusCode();

        using var stream = await response.Content.ReadAsStreamAsync();
        using var document = await JsonDocument.ParseAsync(stream);

        if (document.RootElement.ValueKind != JsonValueKind.Array) 
        { 
            throw new InvalidOperationException($"Słownik {endpoint} nie zwraca tablicy JSON."); 
        }

        var result = new List<DictionaryOption>();

        foreach (var element in document.RootElement.EnumerateArray())
        {
            if (!element.TryGetProperty(idPropertyName, out var idProperty))
                throw new InvalidOperationException(
                    $"Brak pola klucza {idPropertyName} w słowniku {endpoint}.");

            if (!element.TryGetProperty(nameProperty, out var namePropertyValue))
                throw new InvalidOperationException(
                    $"Brak pola {nameProperty} w słowniku {endpoint}.");

            result.Add(new DictionaryOption
            {
                Id = idProperty.GetInt32(),
                Name = namePropertyValue.GetString() ?? ""
            });
        }

        return result;
    }

    private async Task SubmitAsync()
    {
        Console.WriteLine($"Name: '{form.Name}'");
        Console.WriteLine($"PolishName: '{form.PolishName}'");
        submitError = null;

        if (stalkHollow is null ||
            sapLeavesStain is null ||
            sapSticky is null ||
            hatHasSpots is null ||
            hatHasGills is null ||
            hatHasRing is null ||
            leafStripes is null ||
            leafSpots is null ||
            leafHoles is null)
        {
            submitError = "Uzupełnij wszystkie pola typu Tak/Nie.";
            return;
        }

        if (form.PlantTypeID <= 0 || form.OccuranceId <= 0 ||
            form.CreateStalkDTO.StalkShapeId <= 0 ||
            form.CreateStalkDTO.StalkColorId <= 0 ||
            form.CreateStalkDTO.StalkSurfaceId <= 0 ||
            form.CreateSapDTO!.SapColorId <= 0 ||
            form.CreateRootDTO!.RootColorId <= 0 ||
            form.CreateRootDTO.RootSurfaceId <= 0 ||
            form.CreateRootDTO.RootThicknessId <= 0 ||
            form.CreateHatDTO!.HatColorId <= 0 ||
            form.CreateHatDTO.HatShapeId <= 0 ||
            form.CreateHatDTO.HatThicknessId <= 0 ||
            form.CreateHatDTO.HatSurfaceId <= 0 ||
            form.CreateLeafDTO!.LeafShapeId <= 0 ||
            form.CreateLeafDTO.LeafColorId <= 0 ||
            form.CreateLeafDTO.LeafSurfaceId <= 0 ||
            form.CreateLeafDTO.LeafThicknessId <= 0 ||
            !form.CreateLeafDTO.LeafFlavourId.HasValue ||
            form.CreateFlowerDTO!.FlowerColorId <= 0 ||
            form.CreateFlowerDTO.FlowerShapeId <= 0 ||
            !form.CreateFlowerDTO.FlowerFlavourId.HasValue ||
            !form.CreateFruitDTO!.FruitFlavourId.HasValue ||
            form.CreateFruitDTO.FruitShapeId <= 0 ||
            form.CreateFruitDTO.FruitColorId <= 0 ||
            form.CreateFruitDTO.FruitSurfaceId <= 0 ||
            form.CreateFruitDTO.FruitThicknessId <= 0)
        {
            submitError = "Wybierz wartość we wszystkich wymaganych listach.";
            return;
        }

        form.CreateStalkDTO.StalkIsHollow = stalkHollow.Value;
        form.CreateSapDTO.SapLeavesStain = sapLeavesStain.Value;
        form.CreateSapDTO.SapSticky = sapSticky.Value;
        form.CreateHatDTO.HatHasSpots = hatHasSpots.Value;
        form.CreateHatDTO.HatHasGills = hatHasGills.Value;
        form.CreateHatDTO.HatHasRing = hatHasRing.Value;
        form.CreateLeafDTO.LeafStripes = leafStripes.Value;
        form.CreateLeafDTO.LeafSpots = leafSpots.Value;
        form.CreateLeafDTO.LeafHoles = leafHoles.Value;

        if (!form.PoisonabilityId.HasValue)
        {
            submitError = "Wybierz właściwości trujące rośliny.";
            return;
        }

        isSubmitting = true;

        try
        {
            submissionId = await UserInputApiService.PostUserInputPlantAsync(form);
            submitted = true;
        }
        catch (Exception)
        {
            submitError =
                "Nie udało się zapisać zgłoszenia. " +
                "Sprawdź połączenie z API i spróbuj ponownie.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class DictionaryOption
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }
}