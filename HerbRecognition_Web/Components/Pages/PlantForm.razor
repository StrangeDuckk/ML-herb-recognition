@page "/plant-form"

@using HerbRecognition_Web.Communication.DTOs
@using HerbRecognition_Web.Communication.Services
@using HerbRecognition_Web.Components.Shared

@inject UserInputApiService UserInputApiService
@inject PictureApiService PictureApi

<PageTitle>Formularz zgłoszenia rośliny</PageTitle>

<div class="plants-page submission-page">

    <section class="plants-header">
        <div>
            <span class="section-label">HERB RECOGNITION</span>
            <h1>Zgłoś nową roślinę</h1>
            <p>
                Uzupełnij informacje o roślinie.
                Zgłoszenie zostanie zweryfikowane przed dodaniem do bazy.
            </p>
        </div>
    </section>

    @if (submitted)
    {
        <div class="submission-success">
            <h2>Zgłoszenie zapisane!</h2>
            <p>Dziękujemy. Zgłoszenie oczekuje na weryfikację.</p>
            <p>Numer zgłoszenia: <strong>@submissionId</strong></p>

            @if (photoError is not null)
            {
                <div class="plants-error">
                    Zgłoszenie zapisano, ale bez zdjęć: @photoError
                </div>
            }

            <a href="/search" class="submission-button">Wróć do wyszukiwania</a>
        </div>
    }
    else
    {
        <PlantSubmissionForm SubmitText="Wyślij zgłoszenie"
                             OnSubmit="SubmitAsync"
                             FormName="PlantSubmitAsync">
            <ExtraContent>
                <section class="submission-section">
                    <h2>10. Zdjęcia</h2>
                    <p class="section-description">
                        Dodaj od 1 do 3 zdjęć. Najlepiej sprawdzają się ostre ujęcia w dziennym
                        świetle: cała roślina oraz zbliżenia liści, kwiatów lub kapelusza.
                    </p>

                    <PhotoPicker @bind-Photos="photos" MaxCount="MaxPhotos" />
                </section>
            </ExtraContent>
        </PlantSubmissionForm>
    }
</div>

@code {
    private const int MaxPhotos = 3;

    private bool submitted;
    private int submissionId;
    private string? photoError;
    private List<PhotoUpload> photos = [];

    // wyjątki stąd pokaże formularz nad przyciskiem
    private async Task SubmitAsync(CreatePlantDTO payload)
    {
        if (photos.Count == 0)
            throw new InvalidOperationException("dodaj przynajmniej jedno zdjęcie rośliny (sekcja 10).");

        submissionId = await UserInputApiService.PostUserInputPlantAsync(payload);

        // zgłoszenie już jest – błąd zdjęć nie może go "cofnąć", tylko informujemy
        try
        {
            await PictureApi.UploadForSubmissionAsync(submissionId, photos);
        }
        catch (PictureApiException ex)
        {
            photoError = ex.Message;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd wysyłania zdjęć zgłoszenia #{submissionId}: {ex}");
            photoError = "nie udało się połączyć z serwerem.";
        }

        submitted = true;
    }
}
