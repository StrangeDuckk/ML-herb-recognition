                <section class="submission-section">
                    <h2>8. Owoce</h2>
                    <div class="submission-grid">
                        <div class="submission-field">
                            <label>Smak *</label>
                            <InputSelect @bind-Value="form.CreateFruitDTO!.FruitFlavourId">
                                <option value="">Wybierz smak</option>
                                @foreach (var x in flavours)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Kształt *</label>
                            <InputSelect @bind-Value="form.CreateFruitDTO!.FruitShapeId">
                                <option value="0">Wybierz kształt</option>
                                @foreach (var x in shapes)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Kolor *</label>
                            <InputSelect @bind-Value="form.CreateFruitDTO!.FruitColorId">
                                <option value="0">Wybierz kolor</option>
                                @foreach (var x in colors)
                                {
                                    <option value="@x.Id">@x.Name</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="submission-field">
                            <label>Powierzchnia *</label>
                            <InputSelect @bind-Value="form.CreateFruitDTO!.FruitSurfaceId">
                                <option value="0">Wybierz powierzchnię</option>
                                @foreach (var x in surfaces)
                                {
