@page "/admin/submissions"

@using HerbRecognition_Web.Communication.DTOs
@using HerbRecognition_Web.Communication.Services
@using HerbRecognition_Web.Components.Shared

@inject AdminAuthService Auth
@inject AdminApiService AdminApi
@inject NavigationManager Nav

<PageTitle>Zgłoszenia – panel administratora</PageTitle>

<div class="plants-page admin-page">

    <section class="plants-header admin-header">
        <div>
            <span class="section-label">PANEL ADMINISTRATORA</span>
            <h1>Zgłoszenia roślin</h1>
        </div>
        <button type="button" class="admin-btn secondary" @onclick="RedirectToLogin">Wyloguj</button>
    </section>

    <AdminNav />

    <section class="admin-content">
        <div class="admin-content-head">
            <h2>Czekają na weryfikację</h2>
            @if (!isLoading)
            {
                <span class="admin-count">@items.Count</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="admin-message @(isError ? "error" : "success")">@message</div>
        }

        @if (isLoading)
        {
            <p class="admin-empty">Ładowanie zgłoszeń...</p>
        }
        else if (items.Count == 0)
        {
            <p class="admin-empty">Brak zgłoszeń. Nowe zgłoszenia z formularza pojawią się tutaj.</p>
        }
        else
        {
            <AdminRecordTable Items="items"
                              EditUrl="@(id => $"/admin/submissions/{id}")"
                              OnDelete="DeleteAsync"
                              IsBusy="isBusy" />
        }
    </section>
</div>

@code {
    private List<UserInputSummaryDTO> items = new();

    private bool isLoading = true;
    private bool isBusy;
    private bool isError;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            RedirectToLogin();
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;

        try
        {
            items = await AdminApi.GetSubmissionsAsync();
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (Exception ex)
        {
            items = new();
            ShowMessage($"Nie udało się wczytać zgłoszeń: {ex.Message}", error: true);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task DeleteAsync(int id)
    {
        isBusy = true;
        message = null;

        try
        {
            await AdminApi.DeleteSubmissionAsync(id);
            await LoadAsync();
            ShowMessage($"Usunięto zgłoszenie #{id}.", error: false);
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (Exception ex)
        {
            ShowMessage($"Nie udało się usunąć zgłoszenia: {ex.Message}", error: true);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ShowMessage(string text, bool error)
    {
        message = text;
        isError = error;
    }

    private void RedirectToLogin()
    {
        Auth.Logout();
        Nav.NavigateTo("/admin/login");
    }
}


@* @page "/admin/submissions"

@using HerbRecognition_Web.Communication.DTOs
@using HerbRecognition_Web.Communication.Services
@using HerbRecognition_Web.Components.Shared

@inject AdminAuthService Auth
@inject AdminApiService AdminApi
@inject NavigationManager Nav

<PageTitle>Zgłoszenia – panel administratora</PageTitle>

<div class="plants-page admin-page">

    <section class="plants-header admin-header">
        <div>
            <span class="section-label">PANEL ADMINISTRATORA</span>
            <h1>Zgłoszenia roślin</h1>
        </div>
        <button type="button" class="admin-btn secondary" @onclick="Logout">Wyloguj</button>
    </section>

    <AdminNav />

    <section class="admin-content">
        <div class="admin-content-head">
            <h2>Czekają na weryfikację</h2>
            @if (!isLoading)
            {
                <span class="admin-count">@items.Count</span>
            }
        </div>

        @if (!string.IsNullOrEmpty(message))
        {
            <div class="admin-message @(isError ? "error" : "success")">@message</div>
        }

        @if (isLoading)
        {
            <p class="admin-empty">Ładowanie zgłoszeń...</p>
        }
        else if (items.Count == 0)
        {
            <p class="admin-empty">
                Brak zgłoszeń. Nowe zgłoszenia z formularza pojawią się tutaj.
            </p>
        }
        else
        {
            <div class="admin-table-wrap">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Nr</th>
                            <th>Roślina</th>
                            <th>Typ</th>
                            <th>Części</th>
                            <th>Podobne</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in items)
                        {
                            <tr class="@(item.IsCorrupted ? "admin-row-corrupted" : "")">
                                <td class="admin-id">#@item.Id</td>

                                <td>
                                    <div class="admin-plant-names">
                                        <strong>@item.PolishName</strong>
                                        @if (!item.IsCorrupted)
                                        {
                                            <span>
                                                @item.Name
                                                @if (!string.IsNullOrEmpty(item.LatinName))
                                                {
                                                    <em>(@item.LatinName)</em>
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span>Dane zgłoszenia nie dają się odczytać – możesz je tylko usunąć.</span>
                                        }
                                    </div>
                                </td>

                                <td>@(item.PlantTypeName ?? "–")</td>

                                <td>
                                    @if (item.Parts.Count == 0)
                                    {
                                        <span class="admin-muted">tylko dane podstawowe</span>
                                    }
                                    else
                                    {
                                        <div class="admin-parts">
                                            @foreach (var part in item.Parts)
                                            {
                                                <span class="admin-part">@part</span>
                                            }
                                        </div>
                                    }
                                </td>

                                <td>@(item.SimilarCount == 0 ? "–" : item.SimilarCount.ToString())</td>

                                <td>
                                    <div class="admin-actions">
                                        @if (confirmDeleteId == item.Id)
                                        {
                                            <button type="button" class="admin-btn small danger solid"
                                                    disabled="@isBusy"
                                                    @onclick="() => DeleteAsync(item.Id)">
                                                Na pewno usuń
                                            </button>
                                            <button type="button" class="admin-btn small secondary"
                                                    @onclick="CancelDelete">
                                                Anuluj
                                            </button>
                                        }
                                        else
                                        {
                                            @if (!item.IsCorrupted)
                                            {
                                                <a class="admin-btn small secondary"
                                                   href="@($"/admin/submissions/{item.Id}")">
                                                    Edytuj
                                                </a>
                                            }
                                            <button type="button" class="admin-btn small danger"
                                                    @onclick="() => AskDelete(item.Id)">
                                                Usuń
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

@code {
    private List<UserInputSummaryDTO> items = new();
    private int? confirmDeleteId;

    private bool isLoading = true;
    private bool isBusy;
    private bool isError;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsLoggedIn)
        {
            Nav.NavigateTo("/admin/login");
            return;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;

        try
        {
            items = await AdminApi.GetSubmissionsAsync();
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (Exception ex)
        {
            items = new();
            ShowMessage($"Nie udało się wczytać zgłoszeń: {ex.Message}", error: true);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AskDelete(int id) => confirmDeleteId = id;

    private void CancelDelete() => confirmDeleteId = null;

    private async Task DeleteAsync(int id)
    {
        isBusy = true;
        message = null;

        try
        {
            await AdminApi.DeleteSubmissionAsync(id);
            confirmDeleteId = null;
            await LoadAsync();
            ShowMessage($"Usunięto zgłoszenie #{id}.", error: false);
        }
        catch (UnauthorizedAccessException)
        {
            RedirectToLogin();
        }
        catch (Exception ex)
        {
            ShowMessage($"Nie udało się usunąć zgłoszenia: {ex.Message}", error: true);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ShowMessage(string text, bool error)
    {
        message = text;
        isError = error;
    }

    private void Logout() => RedirectToLogin();

    private void RedirectToLogin()
    {
        Auth.Logout();
        Nav.NavigateTo("/admin/login");
    }
} *@
