@page "/products"

@using System.Globalization
@using HerbRecognition_Web.Communication.DTOs
@using HerbRecognition_Web.Communication.Services
@using HerbRecognition_Web.Components.Shared

@inject ProductApiService ProductApi
@inject AdminAuthService Auth

<PageTitle>Przepisy</PageTitle>

<div class="prod-page">

    <section class="prod-page-header">
        <span class="section-label">HERB RECOGNITION</span>
        <h1>Przepisy</h1>
        <p>
            Syropy, napary, nalewki i maści z roślin z naszej bazy –
            z czego je zrobić i na co pomagają.
        </p>

        <div class="prod-filters">
            <input type="search"
                   class="prod-search"
                   placeholder="Szukaj: nazwa, roślina albo dolegliwość (np. kaszel)"
                   aria-label="Szukaj przepisów"
                   @bind="query" @bind:event="oninput" />

            <label class="prod-switch">
                <input type="checkbox"
                       @bind="showPending"
                       @bind:after="OnShowPendingChangedAsync" />
                <span class="prod-switch-slider" aria-hidden="true"></span>
                <span>Pokaż też przepisy czekające na weryfikację</span>
            </label>

            @if (showPending && isLoadingPending)
            {
                <span class="prod-note">Ładowanie zgłoszeń...</span>
            }
            else if (showPending && pendingError is not null)
            {
                <span class="prod-note is-error">@pendingError</span>
            }
        </div>
    </section>

    @if (!isLoading && errorMessage is null && BaseCards.Any())
    {
        <LibraryFilters ActiveCount="ActiveFilterCount"
                        OnClear="ClearFilters"
                        Summary="@($"Przepisy: {Cards.Count()} z {BaseCards.Count()}")">

            <div class="lib-filter-grid">
                <FilterSelect Label="Typ produktu" Options="typeOptions" @bind-Value="filterType" />
                <FilterSelect Label="Sposób podania" Options="routeOptions" @bind-Value="filterRoute" />
                <FilterSelect Label="Dolegliwość" Options="diseaseOptions" @bind-Value="filterDisease" />
                <FilterSelect Label="Właściwość" Options="propertyOptions" @bind-Value="filterProperty" />
                <FilterSelect Label="Roślina" Options="plantOptions" @bind-Value="filterPlant" />
                <FilterSelect Label="Substancja czynna" Options="substanceOptions" @bind-Value="filterSubstance" />
            </div>

            @if (contraindicationOptions.Count > 0)
            {
                <div class="lib-filter-exclude">
                    <span class="lib-filter-label" id="exclude-label">Bez przeciwwskazania</span>
                    <p class="lib-filter-hint">
                        Zaznacz, co Cię dotyczy – np. „ciąża”. Ukryjemy przepisy z tym przeciwwskazaniem.
                    </p>

                    <div class="lib-chip-row" role="group" aria-labelledby="exclude-label">
                        @foreach (var option in contraindicationOptions)
                        {
                            var isOn = excluded.Contains(option.Value);

                            <button type="button"
                                    class="lib-chip @(isOn ? "is-excluded" : "")"
                                    aria-pressed="@(isOn ? "true" : "false")"
                                    @onclick="() => ToggleExcluded(option.Value)">
                                <span class="lib-chip-mark" aria-hidden="true">@(isOn ? "✕" : "+")</span>
                                @option.Text
                            </button>
                        }
                    </div>
                </div>
            }
        </LibraryFilters>
    }

    @if (isLoading)
    {
        <div class="prod-status">
            <div class="prod-spinner"></div>
            <p>Ładowanie przepisów...</p>
        </div>
    }
    else if (errorMessage is not null)
    {
        <div class="prod-status is-error">
            <h2>Nie udało się pobrać przepisów</h2>
            <p>@errorMessage</p>
            <button type="button" class="prod-button" @onclick="LoadAsync">Spróbuj ponownie</button>
        </div>
    }
    else if (!Cards.Any())
    {
        <div class="prod-status">
            @if (!BaseCards.Any() && string.IsNullOrWhiteSpace(query))
            {
                <h2>Brak przepisów</h2>
                <p>Baza nie zawiera jeszcze przepisów. Dodaj pierwszy!</p>
            }
            else if (ActiveFilterCount > 0)
            {
                <h2>Żaden przepis nie pasuje do filtrów</h2>
                <p>Zmień albo wyczyść filtry – albo dodaj przepis, którego szukasz.</p>
                <p><button type="button" class="lib-filters-clear" @onclick="ClearFilters">Wyczyść filtry</button></p>
            }
            else
            {
                <h2>Nic nie pasuje do „@query.Trim()”</h2>
                <p>Spróbuj innej nazwy rośliny albo dolegliwości – albo dodaj ten przepis.</p>
            }
            <a href="/product-form" class="prod-button">Dodaj przepis <span aria-hidden="true">→</span></a>
        </div>
    }
    else
    {
        <section class="prod-grid">
            @foreach (var item in Cards)
            {
                <ProductCard @key="(item.IsPending, item.Id)" Item="item" ShowEdit="Auth.IsLoggedIn" />
            }

            @* ostatni kafelek – jak w bibliotece roślin *@
            <div class="prod-card-cta">
                <span class="prod-card-cta-icon" aria-hidden="true">🍯</span>
                <p>Nie ma przepisu, którego szukasz? Możesz dodać go za pomocą formularza.</p>
                <a href="/product-form" class="prod-button">Przejdź do formularza <span aria-hidden="true">→</span></a>
            </div>
        </section>
    }
</div>

@code {

    private static readonly CultureInfo Polish = new("pl-PL");
    private static readonly StringComparer PolishOrder = StringComparer.Create(Polish, ignoreCase: true);

    /// <summary>Tekst z wyszukiwarki na stronie głównej: /products?q=kaszel</summary>
    [SupplyParameterFromQuery(Name = "q")]
    public string? Q { get; set; }

    private List<ProductPreviewDTO> products = new();
    private List<ProductPreviewDTO> pending = new();

    private string query = "";
    private string? appliedQ;
    private bool isLoading = true;
    private string? errorMessage;

    private bool showPending;
    private bool pendingLoaded;
    private bool isLoadingPending;
    private string? pendingError;

    // ----- filtry (null = wyłączony) -----
    private string? filterType;
    private string? filterRoute;
    private string? filterDisease;
    private string? filterProperty;
    private string? filterPlant;
    private string? filterSubstance;
    private readonly HashSet<string> excluded = new(StringComparer.Create(new CultureInfo("pl-PL"), true));

    // opcje list – liczone z kafelków po każdej zmianie danych
    private List<FilterSelect.Option> typeOptions = new();
    private List<FilterSelect.Option> routeOptions = new();
    private List<FilterSelect.Option> diseaseOptions = new();
    private List<FilterSelect.Option> propertyOptions = new();
    private List<FilterSelect.Option> plantOptions = new();
    private List<FilterSelect.Option> substanceOptions = new();
    private List<FilterSelect.Option> contraindicationOptions = new();

    private int ActiveFilterCount =>
        new[] { filterType, filterRoute, filterDisease, filterProperty, filterPlant, filterSubstance }
            .Count(f => f is not null)
        + excluded.Count;

    /// <summary>Zatwierdzone + (opcjonalnie) zgłoszenia – zanim zadziałają wyszukiwarka i filtry.</summary>
    private IEnumerable<ProductPreviewDTO> BaseCards =>
        products.Concat(showPending ? pending : Enumerable.Empty<ProductPreviewDTO>());

    /// <summary>Kafelki po wyszukiwarce i filtrach, posortowane po nazwie.</summary>
    private IEnumerable<ProductPreviewDTO> Cards =>
        BaseCards
            .Where(Matches)
            .Where(MatchesFilters)
            .OrderBy(p => p.Name, PolishOrder);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // tekst z adresu trafia do pola wyszukiwania (także przy kolejnym wyszukaniu ze strony głównej);
    // przy wyszukiwaniu od razu szukamy też w zgłoszeniach
    protected override async Task OnParametersSetAsync()
    {
        if (Q == appliedQ) return;

        appliedQ = Q;
        query = Q?.Trim() ?? "";

        if (query.Length > 0 && !showPending)
        {
            showPending = true;
            await OnShowPendingChangedAsync();
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            products = await ProductApi.GetProductsAsync();
            RebuildOptions();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd pobierania przepisów: {ex}");
            errorMessage = "Wystąpił problem podczas komunikacji z API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    // zgłoszenia pobieramy dopiero przy pierwszym włączeniu przełącznika
    private async Task OnShowPendingChangedAsync()
    {
        if (!showPending || pendingLoaded)
        {
            RebuildOptions();
            return;
        }

        isLoadingPending = true;
        pendingError = null;

        try
        {
            pending = await ProductApi.GetPendingProductsAsync();
            pendingLoaded = true;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd pobierania zgłoszeń przepisów: {ex}");
            pendingError = "Nie udało się pobrać niezweryfikowanych przepisów.";
        }
        finally
        {
            isLoadingPending = false;
            RebuildOptions();
        }
    }

    // ------------------------------------------------------------------
    //  Filtry
    // ------------------------------------------------------------------

    private void RebuildOptions()
    {
        var cards = BaseCards.ToList();

        typeOptions = LibraryFilter.Options(cards, p => p.ProductTypeName);
        routeOptions = LibraryFilter.OptionsMany(cards, p => p.AdministrationRoutes);
        diseaseOptions = LibraryFilter.OptionsMany(cards, p => p.Diseases);
        propertyOptions = LibraryFilter.OptionsMany(cards, p => p.HealthProperties);
        plantOptions = LibraryFilter.OptionsMany(cards, p => p.Plants.Select(x => x.Name));
        substanceOptions = LibraryFilter.OptionsMany(cards, p => p.ActiveSubstances);
        contraindicationOptions = LibraryFilter.OptionsMany(cards, p => p.Contraindications);

        // wykluczenie, którego nie ma już w danych, nic nie robi – nie pokazujemy go jako włączonego
        excluded.RemoveWhere(x => !contraindicationOptions.Any(o => LibraryFilter.Same(o.Value, x)));
    }

    private bool MatchesFilters(ProductPreviewDTO p) =>
        LibraryFilter.Is(filterType, p.ProductTypeName)
        && LibraryFilter.Has(filterRoute, p.AdministrationRoutes)
        && LibraryFilter.Has(filterDisease, p.Diseases)
        && LibraryFilter.Has(filterProperty, p.HealthProperties)
        && LibraryFilter.Has(filterPlant, p.Plants.Select(x => x.Name))
        && LibraryFilter.Has(filterSubstance, p.ActiveSubstances)
        // np. zaznaczona "ciąża" -> zostają tylko przepisy bez tego przeciwwskazania
        && !p.Contraindications.Any(c => excluded.Contains(c.Trim()));

    private void ToggleExcluded(string name)
    {
        if (!excluded.Remove(name))
            excluded.Add(name);
    }

    private void ClearFilters()
    {
        filterType = filterRoute = filterDisease = filterProperty = filterPlant = filterSubstance = null;
        excluded.Clear();
    }

    // ------------------------------------------------------------------
    //  Wyszukiwarka tekstowa
    // ------------------------------------------------------------------

    private bool Matches(ProductPreviewDTO p)
    {
        var text = query.Trim();
        if (text.Length == 0) return true;

        return Has(p.Name, text)
               || Has(p.ProductTypeName, text)
               || p.Plants.Any(x => Has(x.Name, text))
               || p.Diseases.Any(x => Has(x, text))
               || p.HealthProperties.Any(x => Has(x, text))
               || p.ActiveSubstances.Any(x => Has(x, text))
               || p.AdministrationRoutes.Any(x => Has(x, text));
    }

    private static bool Has(string? source, string text) =>
        source is not null && Polish.CompareInfo.IndexOf(source, text, CompareOptions.IgnoreCase | CompareOptions.IgnoreNonSpace) >= 0;
}
