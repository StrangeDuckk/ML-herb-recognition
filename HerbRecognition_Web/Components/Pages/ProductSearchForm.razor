@page "/products/search"

@using HerbRecognition_Web.Communication.DTOs
@using HerbRecognition_Web.Communication.Services
@using HerbRecognition_Web.Components.Shared

@inject ProductApiService ProductApi
@inject AdminAuthService Auth

<PageTitle>Wyszukaj przepis przez formularz</PageTitle>

<div class="plants-page submission-page">

    <section class="prs-hero">
        <div>
            <span class="section-label">WYSZUKIWANIE PRZEPISÓW</span>
            <h1>Wyszukaj przez formularz</h1>
            <p>
                Na co szukasz przepisu? Wybierz dolegliwość, rośliny, które masz pod ręką,
                albo typ produktu – pokażemy przepisy, które najbardziej pasują.
            </p>
        </div>

        <div class="prs-hero-side">
            <div class="prs-hint">
                <strong>Wypełnij tylko to, czego potrzebujesz.</strong>
                Puste pola nie obniżają wyniku.
            </div>
            <a href="/products" class="back-link">← Wszystkie przepisy</a>
        </div>
    </section>

    @* ten sam formularz co przy dodawaniu przepisu – w trybie wyszukiwania *@
    <ProductSubmissionForm SearchMode="true"
                           SubmitText="Wyszukaj"
                           BusyText="Wyszukiwanie..."
                           OnSearch="SearchAsync"
                           FormName="ProductSearchForm">
        <ExtraContent>
            <section class="submission-section search-options">
                <h2>Ustawienia wyszukiwania</h2>

                <div class="match-slider">
                    <label for="prs-min-match">
                        Minimalne dopasowanie: <strong>@minMatch%</strong>
                    </label>

                    <input id="prs-min-match" type="range" min="0" max="100" step="5"
                           @bind="minMatch" @bind:event="oninput" />

                    <div class="match-scale">
                        <span>0% – wszystkie przepisy</span>
                        <span>50%</span>
                        <span>100% – wszystko się zgadza</span>
                    </div>

                    <p class="section-description">
                        Każda wybrana dolegliwość, roślina, właściwość i substancja liczy się tak samo
                        jak typ produktu. Nazwa i słowa z przepisu liczą się najmniej.
                    </p>
                </div>

                <label class="switch-label">
                    <span>Uwzględnij przepisy czekające na weryfikację</span>
                    <input type="checkbox" class="switch-input" @bind="includePending" />
                    <span class="switch-slider"></span>
                </label>
            </section>
        </ExtraContent>
    </ProductSubmissionForm>

    @if (response is not null)
    {
        <section class="prs-results" aria-live="polite">

            <h2 class="prs-results-title" tabindex="-1" @ref="resultsHeading">Wyniki</h2>

            <p class="prs-results-meta">
                Wyszukano o @searchedAt.ToString("HH:mm:ss") ·
                porównano przepisów: @response.CheckedCount ·
                cech: @response.CriteriaCount ·
                próg @response.MinMatchPercent%
            </p>

            @if (response.CriteriaCount == 0)
            {
                <div class="prod-status">
                    <h2>Formularz jest pusty</h2>
                    <p>Wybierz co najmniej jedną dolegliwość, roślinę albo typ produktu i wyszukaj ponownie.</p>
                </div>
            }
            else if (response.Results.Count == 0)
            {
                <div class="prod-status">
                    <h2>Brak przepisów z takim dopasowaniem</h2>
                    <p>
                        Żaden przepis nie zgadza się w co najmniej @response.MinMatchPercent%.
                        Obniż próg albo usuń część kryteriów – albo dodaj taki przepis.
                    </p>
                    <a href="/product-form" class="prod-button">Dodaj przepis <span aria-hidden="true">→</span></a>
                </div>
            }
            else
            {
                <section class="prod-grid">
                    @foreach (var result in response.Results)
                    {
                        <ProductCard @key="(result.IsPending, result.Id)"
                                     Item="result"
                                     ShowEdit="Auth.IsLoggedIn"
                                     MatchPercent="result.MatchPercent"
                                     MatchedCount="result.MatchedCount"
                                     ComparedCount="result.ComparedCount" />
                    }
                </section>
            }
        </section>
    }
</div>

@code {
    private int minMatch = 50;
    private bool includePending = true;

    private ProductSearchResponseDTO? response;
    private DateTime searchedAt;

    private ElementReference resultsHeading;
    private bool scrollToResults;

    // wyjątki stąd pokaże formularz nad przyciskiem "Wyszukaj"
    private async Task SearchAsync(ProductSearchCriteriaDTO criteria)
    {
        criteria.MinMatchPercent = minMatch;
        criteria.IncludePending = includePending;

        response = await ProductApi.SearchByFormAsync(criteria);
        searchedAt = DateTime.Now;
        scrollToResults = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollToResults) return;
        scrollToResults = false;

        try
        {
            await resultsHeading.FocusAsync();   // przewija do wyników
        }
        catch (Exception)
        {
            // brak przewinięcia nie jest problemem
        }
    }
}
