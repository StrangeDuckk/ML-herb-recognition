@using HerbRecognition_Web.Communication.DTOs
@using HerbRecognition_Web.Communication.Services
@using HerbRecognition_Web.Components.Shared

@inject ProductApiService ProductApi
@inject PlantApiService PlantApi

@*
    Wspólny formularz produktu (przepisu) – jak PlantSubmissionForm.
    - zgłoszenie z widoku rośliny: FixedPlant = ta roślina (nie da się jej usunąć),
    - panel admina: Initial = dane zgłoszenia / produktu, AdminMode = true
      (nowe wartości od razu przypisuje się do słownika w oknie dialogowym),
    - wyszukiwanie: SearchMode = true, nic nie jest wymagane, bez "Dodaj nową",
      przeciwwskazania działają jako filtr, przycisk wywołuje OnSearch z kryteriami.
    Sposób podania to mały słownik admina – wybór kafelkami, bez "Dodaj nową".
    Błędy rzucone przez OnSubmit/OnSecondary/OnSearch są wyświetlane nad przyciskami.
    Po nieudanej próbie wysłania brakujące pola są podświetlone na czerwono (z opisem pod polem),
    a strona przewija się do pierwszej sekcji z błędem. Podświetlenie znika, gdy pole zostanie uzupełnione.
*@

@if (isLoading)
{
    <div class="plants-status">
        <div class="loading-spinner"></div>
        <p>Ładowanie formularza...</p>
    </div>
}
else if (!string.IsNullOrEmpty(loadError))
{
    <div class="plants-error">
        <h2>Nie udało się załadować formularza</h2>
        <p>@loadError</p>
        <button type="button" class="submission-button" @onclick="InitializeAsync">Spróbuj ponownie</button>
    </div>
}
else
{
    <EditForm Model="model" FormName="@FormName">
        <div class="submission-form">

            @* ================= 1. Informacje podstawowe ================= *@
            <section class="submission-section @SectionError(NameInvalid || TypeInvalid)" @ref="basicSection" tabindex="-1">
                <header class="submission-section-head">
                    <h2>1. Informacje podstawowe</h2>
                </header>

                @if (!SearchMode)
                {
                    <p class="section-description">Pola oznaczone * są wymagane.</p>
                }

                <div class="submission-grid">
                    <div class="submission-field @FieldError(NameInvalid)">
                        <label for="product-name">Nazwa produktu@(Req)</label>
                        <InputText id="product-name" @bind-Value="model.Name" maxlength="300"
                                   aria-invalid="@AriaInvalid(NameInvalid)"
                                   placeholder="@(SearchMode ? "np. syrop" : "np. Syrop z kwiatów mniszka")" />
                        @ErrorText(NameInvalid, "Podaj nazwę produktu (co najmniej 2 znaki).")
                    </div>

                    <div class="submission-field @FieldError(TypeInvalid)">
                        <label for="product-type">Typ produktu@(Req)</label>
                        <InputSelect id="product-type" @bind-Value="model.ProductTypeId"
                                     aria-invalid="@AriaInvalid(TypeInvalid)">
                            <option value="0">@(SearchMode ? "Nie wiem / dowolny" : "Wybierz typ")</option>
                            @foreach (var type in productTypes)
                            {
                                <option value="@type.ProductTypeId">@type.Name</option>
                            }
                        </InputSelect>
                        @ErrorText(TypeInvalid, "Wybierz typ produktu.")
                    </div>
                </div>
            </section>

            @* ================= 2. Rośliny ================= *@
            <section class="submission-section @SectionError(PlantsInvalid)" @ref="plantsSection" tabindex="-1">
                <header class="submission-section-head">
                    <h2>2. Rośliny@(Req)</h2>
                </header>
                <p class="section-description">
                    @if (SearchMode)
                    {
                        <text>Rośliny, które masz pod ręką – przepisy z nimi będą wyżej w wynikach.</text>
                    }
                    else
                    {
                        <text>Z jakich roślin powstaje produkt. Możesz wskazać też rośliny, które czekają na weryfikację.</text>
                    }
                </p>

                @if (FixedPlant is not null)
                {
                    <div class="dict-chips product-fixed-plant">
                        <span class="dict-chip is-fixed">
                            🌿 @FixedPlant.Name
                            <small>roślina, z której dodajesz przepis</small>
                        </span>
                    </div>
                }

                <div class="submission-field @FieldError(PlantsInvalid)">
                    <SimilarPlantPicker @bind-Selected="plants" ExcludePlantId="FixedPlant?.Id" />
                    @ErrorText(PlantsInvalid, "Wskaż przynajmniej jedną roślinę.")
                </div>
            </section>

            @* ================= 3. Na co działa ================= *@
            <section class="submission-section @SectionError(DiseaseInvalid)" @ref="effectsSection" tabindex="-1">
                <header class="submission-section-head">
                    <h2>3. Na co działa</h2>
                </header>
                <p class="section-description">
                    @if (SearchMode)
                    {
                        <text>Dolegliwości, właściwości lub substancje, których szukasz. Każda wybrana pozycja liczy się osobno.</text>
                    }
                    else
                    {
                        <text>
                            Wpisz kilka liter i wybierz z listy. Jeśli czegoś brakuje, dodaj nową wartość –
                            @(AdminMode ? "od razu przypiszesz ją do słownika." : "administrator sprawdzi ją przed publikacją.")
                        </text>
                    }
                </p>

                <div class="product-dict-grid">
                    @DictionaryField(ProductDictionary.Disease, $"Choroby{Req}", "np. przeziębienie, kaszel",
                    DiseaseInvalid, "Wskaż przynajmniej jedną chorobę, na którą działa produkt.")
                @DictionaryField(ProductDictionary.HealthProperty, "Właściwości zdrowotne", "np. przeciwzapalne")
                @DictionaryField(ProductDictionary.ActiveSubstance, "Substancje czynne", "np. flawonoidy")
            </div>
        </section>

        @* ================= 4. Przeciwwskazania ================= *@
        <section class="submission-section">
            <header class="submission-section-head">
                <h2>4. @(SearchMode ? "Bezpieczeństwo" : "Przeciwwskazania")</h2>
            </header>
            <p class="section-description">
                @if (SearchMode)
                    {
                        <text>
                            Pomiń przepisy z wybranymi przeciwwskazaniami – np. „ciąża”.
                            To filtr: takie przepisy w ogóle nie pojawią się w wynikach.
                        </text>
                    }
                    else
                    {
                        <text>Kto nie powinien stosować produktu – np. ciąża, alergie, choroby nerek.</text>
                    }
                </p>

                @DictionaryField(ProductDictionary.Contraindication,
                SearchMode ? "Wyklucz przeciwwskazania" : "Przeciwwskazania", "np. ciąża")
        </section>

        @* ================= 5. Przepis ================= *@
        <section class="submission-section @SectionError(RecipeInvalid)" @ref="recipeSection" tabindex="-1">
            <header class="submission-section-head">
                <h2>5. Przepis@(Req)</h2>
            </header>

            @if (SearchMode)
                {
                    <p class="section-description">Słowa, które mają się pojawić w przepisie – np. „miód”, „cytryna”.</p>

                    <div class="submission-field submission-field--wide">
                        <label for="product-recipe">Słowa z przepisu</label>
                        <InputText id="product-recipe" @bind-Value="model.Recipe" maxlength="300"
                                   placeholder="np. miód, cytryna" />
                    </div>
                }
                else
                {
                    <p class="section-description">Składniki, kolejne kroki przygotowania i sposób stosowania.</p>

                    <div class="submission-field submission-field--wide @FieldError(RecipeInvalid)">
                        <label for="product-recipe" class="visually-hidden">Przepis</label>
                        <InputTextArea id="product-recipe" class="product-recipe" rows="10" maxlength="10000"
                                       @bind-Value="model.Recipe"
                                       aria-invalid="@AriaInvalid(RecipeInvalid)"
                                       placeholder="1. Zbierz kwiaty… 2. Zalej wodą… 3. Gotuj 15 minut…" />
                        @ErrorText(RecipeInvalid, "Opisz przepis (co najmniej 10 znaków).")
                        <p class="photo-hint">@model.Recipe.Length / 10 000 znaków</p>
                    </div>

                    <div class="submission-field submission-field--wide">
                        <label for="product-source">Źródło przepisu</label>
                        <InputText id="product-source" @bind-Value="model.Source" maxlength="500"
                                   placeholder="np. https://ziola.pl/syrop-z-mniszka, „Zioła polskie” – J. Kowalski, przepis własny" />
                        <p class="photo-hint">
                            Adres strony, autor lub książka – albo „przepis własny”.
                            Adres (https://… albo coś.pl) będzie linkiem otwieranym w nowej karcie.
                        </p>

                        @if (SourceLink.HasLink(model.Source))
                        {
                            <p class="prd-source-preview">
                                Podgląd: <ProductSourceLink Source="@model.Source" />
                            </p>
                        }
                    </div>
                }
            </section>

            @* ================= 6. Stosowanie ================= *@
            <section class="submission-section">
                <header class="submission-section-head">
                    <h2>6. Stosowanie</h2>
                </header>
                <p class="section-description">
                    @if (SearchMode)
                    {
                        <text>Jak chcesz stosować produkt – np. tylko doustnie albo tylko na skórę.</text>
                    }
                    else
                    {
                        <text>Jak podawać produkt i ile go stosować. Możesz zaznaczyć kilka sposobów.</text>
                    }
                </p>

                <div class="submission-field submission-field--wide">
                    <span class="submission-label" id="route-label">Sposób podania</span>

                    @if (entries[ProductDictionary.AdministrationRoute].Count == 0)
                    {
                        <p class="photo-hint">Słownik sposobów podania jest pusty – administrator może go uzupełnić w panelu.</p>
                    }
                    else
                    {
                        <div class="route-toggles" role="group" aria-labelledby="route-label">
                            @foreach (var route in entries[ProductDictionary.AdministrationRoute])
                            {
                                var isOn = selected[ProductDictionary.AdministrationRoute].Contains(route.Id);

                                <button type="button"
                                        class="route-toggle @(isOn ? "is-on" : "")"
                                        aria-pressed="@(isOn ? "true" : "false")"
                                        disabled="@IsBusy"
                                        @onclick="() => ToggleRoute(route.Id)">
                                    <span class="route-toggle-mark" aria-hidden="true">@(isOn ? "✓" : "+")</span>
                                    @route.Name
                                </button>
                            }
                        </div>
                    }
                </div>

                @if (!SearchMode)
                {
                    <div class="submission-field submission-field--wide">
                        <label for="product-dosage">Proponowana dawka</label>
                        <InputTextArea id="product-dosage" class="product-recipe product-dosage" rows="3" maxlength="1000"
                                       @bind-Value="model.Dosage"
                                       placeholder="np. dorośli: 1 łyżka 3 razy dziennie; dzieci od 6 lat: 1 łyżeczka 2 razy dziennie" />
                        <p class="photo-hint">@(model.Dosage?.Length ?? 0) / 1000 znaków</p>
                    </div>
                }
            </section>

            @ExtraContent

            @if (!SearchMode && AdminMode && ProposalCount > 0)
            {
                <div class="admin-message error" role="status">
                    Do przypisania w słownikach: @ProposalCount
                    (pomarańczowe wpisy – przycisk „Przypisz”).
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(submitError))
            {
                <div class="plants-error" role="alert">@submitError</div>
            }

            <div class="submission-actions">
                @if (!SearchMode && OnSecondary.HasDelegate)
                {
                    <button type="button" class="submission-button secondary"
                            disabled="@IsBusy"
                            @onclick="() => RunAsync(OnSecondary, SecondaryText, RequireResolvedForSecondary)">
                        @(busyAction == SecondaryText ? BusyText : SecondaryText)
                    </button>
                }

                <button type="button" class="submission-button"
                        disabled="@IsBusy"
                        @onclick="PrimaryAsync">
                    @(busyAction == SubmitText ? BusyText : SubmitText)
                </button>
            </div>
        </div>
    </EditForm>

    @if (resolving is { } r)
    {
        <DictionaryResolveDialog @key="r.Proposal"
                                 Kind="r.Kind"
                                 Proposal="r.Proposal"
                                 Entries="entries[r.Kind]"
                                 OnResolved="ResolveWith"
                                 OnCreated="ResolveWithNewAsync"
                                 OnCancel="() => resolving = null"
                                 OnUnauthorized="OnUnauthorized" />
    }
}

@code {
    // ------------------------------------------------------------------
    //  Parametry
    // ------------------------------------------------------------------

    [Parameter] public CreateProductDTO? Initial { get; set; }

    /// <summary>Roślina, z której otwarto formularz – zawsze w produkcie.</summary>
    [Parameter] public PlantRefDTO? FixedPlant { get; set; }

    /// <summary>Admin: nowe wartości od razu przypisuje do słownika.</summary>
    [Parameter] public bool AdminMode { get; set; }

    [Parameter] public string SubmitText { get; set; } = "Wyślij zgłoszenie";
    [Parameter] public EventCallback<CreateProductDTO> OnSubmit { get; set; }
    [Parameter] public bool RequireResolvedForSubmit { get; set; }

    [Parameter] public string SecondaryText { get; set; } = "Zapisz zmiany";
    [Parameter] public EventCallback<CreateProductDTO> OnSecondary { get; set; }
    [Parameter] public bool RequireResolvedForSecondary { get; set; }

    [Parameter] public string BusyText { get; set; } = "Zapisywanie...";
    [Parameter] public string FormName { get; set; } = "ProductSubmission";

    /// <summary>Tryb wyszukiwania: nic nie jest wymagane, przycisk wywołuje OnSearch.</summary>
    [Parameter] public bool SearchMode { get; set; }
    [Parameter] public EventCallback<ProductSearchCriteriaDTO> OnSearch { get; set; }

    /// <summary>Dodatkowa zawartość nad przyciskami (np. zdjęcia, ustawienia wyszukiwania).</summary>
    [Parameter] public RenderFragment? ExtraContent { get; set; }

    /// <summary>Sesja admina wygasła (okno słownika).</summary>
    [Parameter] public EventCallback OnUnauthorized { get; set; }

    // ------------------------------------------------------------------
    //  Stan
    // ------------------------------------------------------------------

    private sealed class FormModel
    {
        public string Name { get; set; } = "";
        public string Recipe { get; set; } = "";
        public string? Dosage { get; set; }
        public string? Source { get; set; }
        public int ProductTypeId { get; set; }
    }

    private FormModel model = new();
    private List<ProductTypeOption> productTypes = new();
    private List<SimilarPlantCandidateDTO> plants = new();

    private readonly Dictionary<ProductDictionary, List<DictionaryEntry>> entries = new();
    private readonly Dictionary<ProductDictionary, List<int>> selected = new();
    private readonly Dictionary<ProductDictionary, List<DictionaryProposal>> proposals = new();

    private (ProductDictionary Kind, DictionaryProposal Proposal)? resolving;

    private bool isLoading = true;
    private string? loadError;
    private string? submitError;
    private string? busyAction;
    private bool IsBusy => busyAction is not null;

    private string Req => SearchMode ? "" : " *";

    // ------------------------------------------------------------------
    //  Podświetlanie brakujących pól
    // ------------------------------------------------------------------

    /// <summary>Włączane przy pierwszej nieudanej próbie wysłania – wcześniej nic nie świeci na czerwono.</summary>
    private bool showErrors;

    private ElementReference basicSection;
    private ElementReference plantsSection;
    private ElementReference effectsSection;
    private ElementReference recipeSection;

    private bool Check(bool missing) => showErrors && !SearchMode && missing;

    private bool NameInvalid => Check(model.Name.Trim().Length < 2);
    private bool TypeInvalid => Check(model.ProductTypeId <= 0);
    private bool PlantsInvalid => Check((FixedPlant is null ? 0 : 1) + plants.Count == 0);
    private bool DiseaseInvalid => Check(selected.GetValueOrDefault(ProductDictionary.Disease)?.Count
                                         + proposals.GetValueOrDefault(ProductDictionary.Disease)?.Count == 0);
    private bool RecipeInvalid => Check(model.Recipe.Trim().Length < 10);

    private static string FieldError(bool invalid) => invalid ? "is-invalid" : "";
    private static string SectionError(bool invalid) => invalid ? "has-error" : "";
    private static string? AriaInvalid(bool invalid) => invalid ? "true" : null;

    private static RenderFragment ErrorText(bool invalid, string text) => __builder =>
    {
        if (invalid && !string.IsNullOrEmpty(text))
        {
            <span class="field-error" role="alert">@text</span>
        }
    };

    /// <summary>Przewija do pierwszej sekcji z brakującym polem.</summary>
    private async Task FocusFirstErrorAsync()
    {
        ElementReference? target =
            NameInvalid || TypeInvalid ? basicSection :
            PlantsInvalid ? plantsSection :
            DiseaseInvalid ? effectsSection :
            RecipeInvalid ? recipeSection :
            null;

        if (target is null) return;

        try
        {
            await target.Value.FocusAsync();   // przeglądarka sama przewija do elementu
        }
        catch
        {
            // np. sekcja jeszcze niewyrenderowana – komunikat na dole i tak jest widoczny
        }
    }
    private int ProposalCount => proposals.Values.Sum(p => p.Count);

    // ------------------------------------------------------------------
    //  Inicjalizacja
    // ------------------------------------------------------------------

    protected override async Task OnInitializedAsync() => await InitializeAsync();

    private async Task InitializeAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            productTypes = await ProductApi.GetProductTypesAsync();

            foreach (var kind in ProductDictionaries.All)
            {
                entries[kind] = await ProductApi.GetDictionaryAsync(kind);
                selected[kind] = new List<int>();
                proposals[kind] = new List<DictionaryProposal>();
            }

            model = new FormModel();
            plants = new List<SimilarPlantCandidateDTO>();

            if (Initial is not null)
                await LoadFromAsync(Initial);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd ładowania formularza produktu: {ex}");
            loadError = "Nie udało się pobrać słowników z API.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadFromAsync(CreateProductDTO dto)
    {
        model.Name = dto.Name ?? "";
        model.Recipe = dto.Recipe ?? "";
        model.Dosage = dto.Dosage;
        model.Source = dto.Source;
        model.ProductTypeId = dto.ProductTypeId;

        selected[ProductDictionary.HealthProperty] = dto.HealthPropertyIds?.ToList() ?? new();
        selected[ProductDictionary.ActiveSubstance] = dto.ActiveSubstanceIds?.ToList() ?? new();
        selected[ProductDictionary.Disease] = dto.DiseaseIds?.ToList() ?? new();
        selected[ProductDictionary.Contraindication] = dto.ContraindicationIds?.ToList() ?? new();
        selected[ProductDictionary.AdministrationRoute] = dto.AdministrationRouteIds?.ToList() ?? new();

        proposals[ProductDictionary.HealthProperty] = ToProposals(dto.NewHealthProperties);
        proposals[ProductDictionary.ActiveSubstance] = ToProposals(dto.NewActiveSubstances);
        proposals[ProductDictionary.Contraindication] = ToProposals(dto.NewContraindications);
        proposals[ProductDictionary.Disease] = dto.NewDiseases?
            .Select(d => new DictionaryProposal { Name = d.Name, Description = d.Symptoms })
            .ToList() ?? new();

        var plantIds = dto.PlantIds?.Where(id => id != FixedPlant?.Id).ToList();
        var userInputIds = dto.PlantUserInputIds;

        if ((plantIds?.Count ?? 0) + (userInputIds?.Count ?? 0) == 0) return;

        try
        {
            plants = await PlantApi.ResolveSimilarAsync(plantIds, userInputIds);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Nie udało się wczytać roślin produktu: {ex}");
            submitError = "Nie udało się wczytać roślin produktu. Odśwież stronę, zanim zapiszesz.";
        }
    }

    private static List<DictionaryProposal> ToProposals(IEnumerable<string>? names) =>
        names?.Select(n => new DictionaryProposal { Name = n }).ToList() ?? new();

    // ------------------------------------------------------------------
    //  Słowniki
    // ------------------------------------------------------------------

    private RenderFragment DictionaryField(ProductDictionary kind, string label, string placeholder,
                                           bool invalid = false, string? error = null) =>
        @<div class="submission-field submission-field--wide @FieldError(invalid)">
        <label>@label</label>
        <DictionaryMultiPicker Kind="kind"
                               Entries="entries[kind]"
                               SelectedIds="selected[kind]"
                               Proposals="proposals[kind]"
                               Label="@label"
                               Placeholder="@placeholder"
                               AdminMode="AdminMode && !SearchMode"
                               AllowProposals="!SearchMode"
                               Disabled="IsBusy"
                               OnChanged="() => submitError = null"
                               OnResolve="p => resolving = (kind, p)" />
    @ErrorText(invalid, error ?? "")
    </div>;

    private void ToggleRoute(int id)
    {
        var list = selected[ProductDictionary.AdministrationRoute];
        if (!list.Remove(id)) list.Add(id);
        submitError = null;
    }

    private void ResolveWith(int id)
    {
        if (resolving is not { } r) return;

        proposals[r.Kind].Remove(r.Proposal);      // nowo wpisana propozycja admina nie jest na liście – nic się nie dzieje
        if (!selected[r.Kind].Contains(id))
            selected[r.Kind].Add(id);

        resolving = null;
        submitError = null;
    }

    private async Task ResolveWithNewAsync(int id)
    {
        if (resolving is not { } r) return;

        // nowy wpis w słowniku – odświeżamy listę, żeby było widać jego nazwę
        entries[r.Kind] = await ProductApi.GetDictionaryAsync(r.Kind);
        ResolveWith(id);
    }

    // ------------------------------------------------------------------
    //  Przyciski
    // ------------------------------------------------------------------

    private Task PrimaryAsync() =>
        SearchMode ? RunSearchAsync() : RunAsync(OnSubmit, SubmitText, RequireResolvedForSubmit);

    private async Task RunAsync(EventCallback<CreateProductDTO> action, string label, bool requireResolved)
    {
        submitError = Validate(requireResolved);
        if (submitError is not null)
        {
            await FocusFirstErrorAsync();
            return;
        }

        busyAction = label;

        try
        {
            await action.InvokeAsync(BuildPayload());
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd zapisu produktu: {ex}");
            submitError = $"Nie udało się zapisać: {ex.Message}";
        }
        finally
        {
            busyAction = null;
        }
    }

    // wyszukiwanie: bez walidacji wymaganych pól – liczy się to, co użytkownik wie
    private async Task RunSearchAsync()
    {
        submitError = null;
        busyAction = SubmitText;

        try
        {
            await OnSearch.InvokeAsync(BuildSearchCriteria());
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd wyszukiwania przepisów: {ex}");
            submitError = $"Nie udało się wyszukać: {ex.Message}";
        }
        finally
        {
            busyAction = null;
        }
    }

    private string? Validate(bool requireResolved)
    {
        showErrors = true;

        var missing = new List<string>();
        if (NameInvalid) missing.Add("nazwa");
        if (TypeInvalid) missing.Add("typ produktu");
        if (PlantsInvalid) missing.Add("rośliny");
        if (DiseaseInvalid) missing.Add("choroby");
        if (RecipeInvalid) missing.Add("przepis");

        if (missing.Count > 1)
            return $"Uzupełnij pola zaznaczone na czerwono: {string.Join(", ", missing)}.";

        if (model.Name.Trim().Length < 2)
            return "Podaj nazwę produktu (co najmniej 2 znaki).";

        if (model.ProductTypeId <= 0)
            return "Wybierz typ produktu.";

        if ((FixedPlant is null ? 0 : 1) + plants.Count == 0)
            return "Wskaż przynajmniej jedną roślinę.";

        if (selected[ProductDictionary.Disease].Count + proposals[ProductDictionary.Disease].Count == 0)
            return "Wskaż przynajmniej jedną chorobę, na którą działa produkt.";

        if (model.Recipe.Trim().Length < 10)
            return "Opisz przepis (co najmniej 10 znaków).";

        if ((model.Dosage?.Trim().Length ?? 0) > 1000)
            return "Proponowana dawka może mieć najwyżej 1000 znaków.";

        if ((model.Source?.Trim().Length ?? 0) > 500)
            return "Źródło przepisu może mieć najwyżej 500 znaków.";

        if (requireResolved && ProposalCount > 0)
            return "Najpierw przypisz nowe wpisy do słowników (pomarańczowe – przycisk „Przypisz”).";

        return null;
    }

    // ------------------------------------------------------------------
    //  Zgłoszenie / edycja -> CreateProductDTO
    // ------------------------------------------------------------------

    private CreateProductDTO BuildPayload()
    {
        var approvedPlants = plants.Where(p => p.IsApproved).Select(p => p.Id).ToList();
        if (FixedPlant is { IsApproved: true } fixedPlant && !approvedPlants.Contains(fixedPlant.Id))
            approvedPlants.Insert(0, fixedPlant.Id);

        return new CreateProductDTO
        {
            Name = model.Name.Trim(),
            Recipe = model.Recipe.Trim(),
            Dosage = NullIfEmpty(model.Dosage),
            Source = NullIfEmpty(model.Source),
            ProductTypeId = model.ProductTypeId,

            PlantIds = OrNull(approvedPlants),
            PlantUserInputIds = OrNull(plants.Where(p => !p.IsApproved).Select(p => p.Id)),

            HealthPropertyIds = OrNull(selected[ProductDictionary.HealthProperty]),
            ActiveSubstanceIds = OrNull(selected[ProductDictionary.ActiveSubstance]),
            DiseaseIds = OrNull(selected[ProductDictionary.Disease]),
            ContraindicationIds = OrNull(selected[ProductDictionary.Contraindication]),
            AdministrationRouteIds = OrNull(selected[ProductDictionary.AdministrationRoute]),

            NewHealthProperties = OrNull(proposals[ProductDictionary.HealthProperty].Select(p => p.Name)),
            NewActiveSubstances = OrNull(proposals[ProductDictionary.ActiveSubstance].Select(p => p.Name)),
            NewContraindications = OrNull(proposals[ProductDictionary.Contraindication].Select(p => p.Name)),
            NewDiseases = OrNull(proposals[ProductDictionary.Disease].Select(p => new NewDiseaseDTO
            {
                Name = p.Name,
                Symptoms = string.IsNullOrWhiteSpace(p.Description) ? null : p.Description.Trim()
            }))
        };
    }

    // ------------------------------------------------------------------
    //  Wyszukiwanie -> ProductSearchCriteriaDTO (tylko wypełnione pola)
    // ------------------------------------------------------------------

    private ProductSearchCriteriaDTO BuildSearchCriteria() => new()
    {
        Name = NullIfEmpty(model.Name),
        RecipeText = NullIfEmpty(model.Recipe),
        ProductTypeId = model.ProductTypeId > 0 ? model.ProductTypeId : null,

        PlantIds = OrNull(plants.Where(p => p.IsApproved).Select(p => p.Id)),
        PlantUserInputIds = OrNull(plants.Where(p => !p.IsApproved).Select(p => p.Id)),

        DiseaseIds = OrNull(selected[ProductDictionary.Disease]),
        HealthPropertyIds = OrNull(selected[ProductDictionary.HealthProperty]),
        ActiveSubstanceIds = OrNull(selected[ProductDictionary.ActiveSubstance]),
        AdministrationRouteIds = OrNull(selected[ProductDictionary.AdministrationRoute]),

        // w wyszukiwaniu przeciwwskazania = filtr wykluczający
        ExcludeContraindicationIds = OrNull(selected[ProductDictionary.Contraindication])
    };

    private static List<T>? OrNull<T>(IEnumerable<T> items)
    {
        var list = items.ToList();
        return list.Count > 0 ? list : null;
    }

    private static string? NullIfEmpty(string? s) =>
        string.IsNullOrWhiteSpace(s) ? null : s.Trim();
}
