@using HerbRecognition_Web.Communication.DTOs
@using HerbRecognition_Web.Communication.Services

@inject AdminPictureApiService PictureApi

@*
    Zdjęcia rośliny lub zgłoszenia w panelu admina – wygląd jak przy dodawaniu (PhotoPicker),
    plus wybór zdjęcia pierwszego. Każda zmiana zapisuje się od razu.
    Wstawiaj przez ExtraContent formularza – PlantSubmissionForm zostaje bez zdjęć
    (jest też używany w wyszukiwarce).
*@

<section class="submission-section">
    <h2>@Title</h2>
    <p class="section-description">
        Od 1 do @MaxPictures zdjęć. Pierwsze zdjęcie pokazuje się na liście i na stronie rośliny.
        Zmiany zdjęć zapisują się od razu, bez przycisku zapisu formularza.
    </p>

    @if (isLoading)
    {
        <div class="plants-status">
            <div class="loading-spinner"></div>
            <p>Ładowanie zdjęć...</p>
        </div>
    }
    else
    {
        <div class="photo-picker">
            @if (pictures.Count > 0)
            {
                <ul class="photo-grid">
                    @foreach (var picture in pictures)
                    {
                        <li class="photo-tile @(picture.IsMain ? "is-main" : "")">
                            <a href="@picture.Url" target="_blank" rel="noopener">
                                <img src="@SafeUrl.Image(picture.ThumbnailUrl)" alt="Zdjęcie #@picture.Id" loading="lazy" /> @*ubezpieczenie linku do edycji rosliny*@
                            </a>

                            @if (picture.IsMain)
                            {
                                <span class="photo-badge">Pierwsze zdjęcie</span>
                            }
                            else
                            {
                                <button type="button" class="photo-action"
                                        disabled="@IsBusy"
                                        @onclick="() => SetMainAsync(picture.Id)">
                                    Ustaw jako pierwsze
                                </button>
                            }

                            <button type="button"
                                    class="photo-action @(confirmDeleteId == picture.Id ? "is-danger" : "")"
                                    disabled="@IsBusy"
                                    @onclick="() => DeleteAsync(picture.Id)">
                                @(confirmDeleteId == picture.Id ? "Na pewno usunąć?" : "Usuń")
                            </button>
                        </li>
                    }
                </ul>
            }
            else
            {
                <p class="photo-hint">Brak zdjęć.</p>
            }
        </div>

        @if (pictures.Count < MaxPictures)
        {
            @* wybrane zdjęcia od razu trafiają do API i pojawiają się w siatce wyżej *@
            <PhotoPicker Photos="pending"
                         PhotosChanged="OnPhotosPickedAsync"
                         MaxCount="@(MaxPictures - pictures.Count)"
                         Disabled="IsBusy" />
        }

        @if (busy == "upload")
        {
            <p class="photo-hint">Przesyłanie zdjęć...</p>
        }

        @if (error is not null)
        {
            <div class="plants-error" role="alert">@error</div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public PictureOwnerKind Owner { get; set; }
    [Parameter, EditorRequired] public int OwnerId { get; set; }
    [Parameter] public string Title { get; set; } = "Zdjęcia";
    [Parameter] public EventCallback OnUnauthorized { get; set; }

    private const int MaxPictures = 3;

    private List<PictureDTO> pictures = [];
    private List<PhotoUpload> pending = [];
    private bool isLoading = true;
    private string? busy;
    private string? error;
    private int? confirmDeleteId;
    private (PictureOwnerKind, int)? loadedFor;

    private bool IsBusy => busy is not null;

    protected override async Task OnParametersSetAsync()
    {
        // formularz-rodzic odświeża się przy każdej zmianie pola – zdjęcia wczytujemy
        // tylko wtedy, gdy zmieniła się roślina / zgłoszenie
        if (loadedFor == (Owner, OwnerId)) return;
        loadedFor = (Owner, OwnerId);

        isLoading = true;
        await RunAsync("load", async () => pictures = await PictureApi.GetAsync(Owner, OwnerId));
        isLoading = false;
    }

    private async Task OnPhotosPickedAsync(List<PhotoUpload> picked)
    {
        pending = picked;
        if (picked.Count == 0) return;

        await RunAsync("upload", async () =>
            pictures = await PictureApi.UploadAsync(Owner, OwnerId, picked));

        pending = [];
    }

    private Task SetMainAsync(int pictureId) => RunAsync("main", async () =>
    {
        await PictureApi.SetMainAsync(pictureId);
        pictures = await PictureApi.GetAsync(Owner, OwnerId);
    });

    private async Task DeleteAsync(int pictureId)
    {
        // pierwsze kliknięcie tylko pyta o potwierdzenie
        if (confirmDeleteId != pictureId)
        {
            confirmDeleteId = pictureId;
            return;
        }

        await RunAsync("delete", async () =>
        {
            await PictureApi.DeleteAsync(pictureId);
            pictures = await PictureApi.GetAsync(Owner, OwnerId);
        });
    }

    private async Task RunAsync(string action, Func<Task> work)
    {
        busy = action;
        error = null;
        if (action != "delete") confirmDeleteId = null;

        try
        {
            await work();
        }
        catch (UnauthorizedAccessException)
        {
            await OnUnauthorized.InvokeAsync();
        }
        catch (PictureApiException ex)
        {
            error = ex.Message;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Błąd zdjęć ({action}): {ex}");
            error = "Nie udało się połączyć z API. Odśwież stronę i spróbuj ponownie.";
        }
        finally
        {
            busy = null;
            if (action == "delete") confirmDeleteId = null;
        }
    }
}
