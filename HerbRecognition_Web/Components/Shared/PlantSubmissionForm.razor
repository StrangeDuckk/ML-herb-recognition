        } : null
    };

    // ------------------------------------------------------------------
    //  Wyszukiwanie -> PlantSearchCriteriaDTO (tylko wypełnione pola)
    // ------------------------------------------------------------------

    private PlantSearchCriteriaDTO BuildSearchCriteria() => new()
    {
        Name = NullIfEmpty(form.Name),
        PolishName = NullIfEmpty(form.PolishName),
        LatinName = NullIfEmpty(form.LatinName),
        Subriquet = NullIfEmpty(form.Subriquet),
