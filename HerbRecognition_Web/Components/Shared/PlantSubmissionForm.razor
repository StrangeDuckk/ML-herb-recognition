            LeafSurfaceId = form.CreateLeafDTO.LeafSurfaceId,
            LeafLength = form.CreateLeafDTO.LeafLength,
            LeafThicknessId = form.CreateLeafDTO.LeafThicknessId,
            LeafFlavourId = form.CreateLeafDTO.LeafFlavourId,
            LeafMoreInfo = NullIfEmpty(form.CreateLeafDTO.LeafMoreInfo),
            LeafMonthOfHarvestId = form.CreateLeafDTO.LeafMonthOfHarvestId
        } : null,

        CreateFlowerDTO = ShowFlowerSection ? new HerbRecognition_Web.DTOs.CreateFlowerDTO
        {
            FlowerSizeInCm = form.CreateFlowerDTO!.FlowerSizeInCm,
            FlowerColorId = form.CreateFlowerDTO.FlowerColorId,
            FlowerShapeId = form.CreateFlowerDTO.FlowerShapeId,
            FlowerFlavourId = form.CreateFlowerDTO.FlowerFlavourId,
            FlowerScentPower = form.CreateFlowerDTO.FlowerScentPower,
            FlowerMoreInfo = NullIfEmpty(form.CreateFlowerDTO.FlowerMoreInfo),
            FlowerMonthOfHarvestId = form.CreateFlowerDTO.FlowerMonthOfHarvestId
        } : null,

        CreateFruitDTO = ShowFruitSection ? new HerbRecognition_Web.DTOs.CreateFruitDTO
        {
