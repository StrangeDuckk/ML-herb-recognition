            HatSurfaceId = form.CreateHatDTO.HatSurfaceId,
            HatHasSpots = hatHasSpots ?? false,
            HatHasGills = hatHasGills ?? false,
            HatHasRing = hatHasRing ?? false,
            HatMoreInfo = NullIfEmpty(form.CreateHatDTO.HatMoreInfo),
            HatMonthOfHarvestId = form.CreateHatDTO.HatMonthOfHarvestId
        } : null,

        CreateLeafDTO = ShowLeafSection ? new HerbRecognition_Web.DTOs.CreateLeafDTO
