        Flower = ShowFlowerSection ? new PartCriteriaDTO
        {
            ColorId = Positive(form.CreateFlowerDTO!.FlowerColorId),
            ShapeId = Positive(form.CreateFlowerDTO.FlowerShapeId),
            FlavourId = form.CreateFlowerDTO.FlowerFlavourId,
            MonthOfHarvestId = form.CreateFlowerDTO.FlowerMonthOfHarvestId,
            Size = PositiveDecimal(form.CreateFlowerDTO.FlowerSizeInCm),
            ScentPower = flowerScentSearch,
            MoreInfo = NullIfEmpty(form.CreateFlowerDTO.FlowerMoreInfo)
        } : null,

        Fruit = ShowFruitSection ? new PartCriteriaDTO
        {
            FlavourId = form.CreateFruitDTO!.FruitFlavourId,
            ShapeId = Positive(form.CreateFruitDTO.FruitShapeId),
            ColorId = Positive(form.CreateFruitDTO.FruitColorId),
            SurfaceId = Positive(form.CreateFruitDTO.FruitSurfaceId),
            ThicknessId = Positive(form.CreateFruitDTO.FruitThicknessId),
            MonthOfHarvestId = form.CreateFruitDTO.FruitMonthOfHarvestId,
            MoreInfo = NullIfEmpty(form.CreateFruitDTO.FruitMoreInfo)
        } : null
    };

    private static int? Positive(int value) => value > 0 ? value : null;
    private static decimal? PositiveDecimal(decimal value) => value > 0 ? value : null;

    private static List<int>? IdsOrNull(IEnumerable<SimilarPlantCandidateDTO> items)
    {
        var ids = items.Select(i => i.Id).ToList();
        return ids.Count > 0 ? ids : null;
    }

    private static string? NullIfEmpty(string? s) =>
        string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private sealed class DictionaryOption
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
    }
}
