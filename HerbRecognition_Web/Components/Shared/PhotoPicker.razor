@using HerbRecognition_Web.Communication.DTOs

@*
    Wybór zdjęć w przeglądarce – nic nie wysyła do API.
    Zdjęcia są zmniejszane w przeglądarce do 2048 px (JPEG), co przyspiesza wysyłkę
    i usuwa dane EXIF (w tym GPS) jeszcze przed opuszczeniem urządzenia.
    Użycie: <PhotoPicker @bind-Photos="photos" MaxCount="3" />
*@

<div class="photo-picker">
    @if (Photos.Count > 0)
    {
        <ul class="photo-grid">
            @foreach (var photo in Photos)
            {
                <li class="photo-tile">
                    <img src="@photo.PreviewUrl" alt="Wybrane zdjęcie: @photo.FileName" />
                    <button type="button"
                            class="photo-action"
                            disabled="@(Disabled || isReading)"
                            @onclick="() => RemoveAsync(photo)">
                        Usuń
                    </button>
                </li>
            }
        </ul>
    }

    @if (Photos.Count < MaxCount)
    {
        <label class="photo-add @(Disabled || isReading ? "is-disabled" : "")">
            <InputFile OnChange="OnFilesSelectedAsync"
                       multiple
                       accept="image/jpeg,image/png,image/webp,image/heic,image/heif"
                       disabled="@(Disabled || isReading)" />
            <span>@AddLabel</span>
        </label>
        <p class="photo-hint">Możesz dodać jeszcze @(MaxCount - Photos.Count). Pliki JPEG, PNG lub WebP.</p>
    }

    @if (error is not null)
    {
        <p class="photo-error" role="alert">@error</p>
    }
</div>

@code {
    [Parameter] public List<PhotoUpload> Photos { get; set; } = [];
    [Parameter] public EventCallback<List<PhotoUpload>> PhotosChanged { get; set; }
    [Parameter] public int MaxCount { get; set; } = 3;
    [Parameter] public bool Disabled { get; set; }

    private const int UploadMaxSide = 2048;    // API i tak zmniejsza do 1536 px
    private const int PreviewMaxSide = 320;
    private const long MaxReadBytes = 15 * 1024 * 1024;

    private bool isReading;
    private string? error;

    private string AddLabel =>
        isReading ? "Wczytywanie zdjęć…" :
        Photos.Count == 0 ? "Wybierz zdjęcia" : "Dodaj kolejne zdjęcie";

    private async Task OnFilesSelectedAsync(InputFileChangeEventArgs e)
    {
        error = null;

        var free = MaxCount - Photos.Count;
        if (free <= 0) return;

        if (e.FileCount > free)
            error = $"Można dodać jeszcze {free}, pozostałe pliki pominięto.";

        var updated = new List<PhotoUpload>(Photos);
        isReading = true;

        try
        {
            foreach (var file in e.GetMultipleFiles(e.FileCount).Take(free))
            {
                if (!file.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
                {
                    error = $"„{file.Name}” nie jest zdjęciem.";
                    continue;
                }

                try
                {
                    var upload = await file.RequestImageFileAsync("image/jpeg", UploadMaxSide, UploadMaxSide);
                    var preview = await file.RequestImageFileAsync("image/jpeg", PreviewMaxSide, PreviewMaxSide);

                    var data = await ReadAllAsync(upload);
                    var previewData = await ReadAllAsync(preview);

                    updated.Add(new PhotoUpload(
                        Path.ChangeExtension(file.Name, ".jpg"),
                        data,
                        $"data:image/jpeg;base64,{Convert.ToBase64String(previewData)}"));
                }
                catch (Exception)
                {
                    error = $"Nie udało się wczytać „{file.Name}”. Zapisz je jako JPEG lub PNG i wybierz ponownie.";
                }
            }
        }
        finally
        {
            isReading = false;
        }

        await PhotosChanged.InvokeAsync(updated);
    }

    private Task RemoveAsync(PhotoUpload photo)
    {
        error = null;
        return PhotosChanged.InvokeAsync(Photos.Where(p => p != photo).ToList());
    }

    private static async Task<byte[]> ReadAllAsync(IBrowserFile file)
    {
        await using var stream = file.OpenReadStream(MaxReadBytes);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        return ms.ToArray();
    }
}
