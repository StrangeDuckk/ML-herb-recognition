@inherits LayoutComponentBase

<div class="app">

    <header class="top-bar">

        <div class="top-bar-content">

            <a class="brand" href="/">
                <span class="brand-icon">🌿</span>
                <span>Herb Recognition</span>
            </a>

            <nav class="main-nav">
                <NavLink href="/plants" class="nav-link">
                    Wszystkie zioła
                </NavLink>
            </nav>

            <a href="/admin" class="admin-link">Panel admina</a>

        </div>
    </header>


    <main class="main-content">
        @Body
    </main>


    <footer class="footer">
        <div class="footer-content">

            <div class="footer-description">
                <h3>Herb Recognition</h3>

                <p>
                    Aplikacja wspierająca rozpoznawanie i poznawanie
                    właściwości roślin na podstawie ich charakterystycznych cech.
                </p>
            </div>

            @* ostrzeżenie – widoczne na każdej stronie *@
            <p class="footer-disclaimer">
                <span aria-hidden="true">⚠</span>
                Korzystasz na własną odpowiedzialność.
            </p>

        </div>

        <div class="footer-bottom">
            <span>© 2026 Herb Recognition</span>

            <span>
                Projekt zrobiony w ramach pracy inżynierskiej Katarzyny Mikusek ·
                <a href="https://github.com/StrangeDuckk/ML-herb-recognition"
                   target="_blank"
                   rel="noopener noreferrer">
                    GitHub ↗
                </a>
            </span>
        </div>
    </footer>

</div>


<div id="blazor-error-ui" data-nosnippet>
    Wystąpił nieoczekiwany błąd.
    <a href="." class="reload">Odśwież stronę</a>
    <span class="dismiss">🗙</span>
</div>
